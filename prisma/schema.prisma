  tax1Rate         Decimal    @db.Decimal(18, 5)
  tax2Rate         Decimal    @db.Decimal(18, 5)
  taxCodeId        String?
  timestamp        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesOrderId])
  @@index([productId])

  @@map("sales_order_line")
}

