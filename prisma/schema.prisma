// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Admin
  StoreManager
  Customer
  InventoryClerk
  SalesAssociate
  Cashier
  WarehouseStaff
  Auditor
  SupportStaff
}

model User {
  id            String    @id // E.g., NextAuth / Clerk generated id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  
  role          UserRole  @default(Customer)
  adjustments   InventoryAdjustment[]

  // --- RELATIONSHIP TO INFLOW TEAM MEMBER ---
  teamMemberId  String?   @unique
  teamMember    TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)

  inflowCustomerId String?   @unique
  inflowCustomer   Customer? @relation(fields: [inflowCustomerId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("user")
}



// customFields.custom1
model Brand {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  logoUrl     String?
  websiteUrl  String?

  products    Product[]
  groups      ProductGroup[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deletedAt   DateTime?

  @@map("brand")
}

model Category {
  id          String   @id @default(cuid())
  inflowId    String   @unique
  name        String
  slug        String   @unique // e.g., "digital-cameras"
  description String?
  imageUrl    String?
  parentId          String?
  parent            Category?  @relation("CategoryToCategory", fields: [parentId], references: [inflowId])
  children          Category[] @relation("CategoryToCategory")
  productGroups     ProductGroup[]
  products          Product[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("category")
}

  // defaultProduct    Product? @relation("GroupDefaultProduct",fields: [defaultProductId], references: [inflowId])
  // defaultProductId  String?
  // defaultImageId    String?
  // timestamp         String?

model ProductGroup {
  id                String   @id @default(cuid())
  inflowId String   @unique
  name              String
  slug              String   @unique 
  description       String?  @db.Text
  brandId           String?
  categoryId        String?
  isActive          Boolean

  brand             Brand?   @relation(fields: [brandId], references: [id])
  category          Category? @relation(fields: [categoryId], references: [inflowId])

  variants          ProductVariant[]
  images            ProductImage[]
  options           ProductGroupOption[]
  tags              ProductGroupTag[]
  features          ProductGroupFeature[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@map("product_group")
}

model ProductVariant {
  id                String   @id @default(cuid())
  inflowId          String   @unique
  productGroupId    String
  productId         String   @unique
  defaultPrice      Decimal  @db.Decimal(18,5)
  isActive          Boolean @default(true)
  signature         String
  variantCount      Int @default(0)

  group             ProductGroup @relation(fields: [productGroupId], references: [inflowId], onDelete: Cascade)
  product           Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  selections        ProductVariantSelection[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([productGroupId, productId])
  @@unique([productGroupId, signature])
  @@index([productGroupId])
  @@index([productId])
  

  @@map("product_variant")
}

model Product {
  id                      String   @id @default(cuid())
  inflowId                String   @unique
  sku                     String?
  name                    String
  slug                    String   @unique 
  description             String?
  itemType                String?
  autoAssemble            Boolean @default(false)
  isActive                Boolean @default(true)
  isManufacturable        Boolean @default(false)
  includeQuantityBuildable Boolean @default(false)
  standardUomName         String?
  trackExpiry             Boolean @default(false)
  trackLots               Boolean @default(false)
  trackSerials            Boolean @default(false)
  shelfLifeDays           Int?
  sellBeforeExpiryDays    Int?
  expiryNotificationDays  Int?
  weight                  Decimal? @db.Decimal(12,4)
  width                   Decimal? @db.Decimal(12,4)
  height                  Decimal? @db.Decimal(12,4)
  length                  Decimal? @db.Decimal(12,4)
  originCountry           String?
  hsTariffNumber          String?
  remarks                 String?
  lastVendorId            String?
  lastModifiedById        String?
  createdDttm            DateTime?
  lastModifiedDateTime   DateTime?

  brandId           String?
  brand             Brand? @relation(fields: [brandId], references: [id])
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [inflowId])
  lastModifiedBy    TeamMember? @relation(fields: [lastModifiedById], references: [inflowId])
  lastVendor        Vendor? @relation(fields: [lastVendorId], references: [inflowId])

  purchasingUom         ProductUom?
  salesUom              ProductSalesUom?
  cost                  ProductCost?
  variant               ProductVariant?

  tags              ProductTag[]
  features          ProductFeature[]
  inventories       Inventory[]
  inventoryBins     InventoryBin[]
  adjustmentLines   InventoryAdjustmentLine[]
  costAdjustments   ProductCostAdjustment[]
  inventoryLedger   InventoryLedger[]
  transferOrderLines  TransferOrderLine[]
  barcodes          ProductBarcode[]
  prices            ProductPrice[]
  attachments       ProductAttachment[]
  vendorItems       VendorItem[]
  productOperations ProductOperation[]
  taxCodes          ProductTaxCode[]
  images            ProductImage[]
  reorderSettings   reorderSetting[]
  bomComponents     ProductBom[]      @relation("ParentProduct")
  bomUsedIn         ProductBom[]      @relation("ChildProduct")

  orderLineItems         SalesOrderLine[]
  packLines              SalesOrderPackLine[]
  pickLines              SalesOrderPickLine[]
  restockLines           SalesOrderRestockLine[]
  pickAllocationLines    SalesOrderPickAllocationLine[]
  pickAllocationFailures SalesOrderPickAllocationFailure[]


  purchaseLines PurchaseOrderLine[]
  receiveLines  PurchaseOrderReceiveLine[]
  unstockLines  PurchaseOrderUnstockLine[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt   DateTime?

  @@map("product")
}

enum ProductPriceType {
  fixedPrice
  markup
  margin
}

model ProductPrice {
  id                String   @id @default(cuid())
  inflowId          String   @unique
  pricingSchemeId   String
  productId         String   
  priceType         ProductPriceType
  unitPrice         Decimal? @db.Decimal(18,5)
  fixedMarkup       Decimal? @db.Decimal(18,5)

  pricingScheme     PricingScheme @relation(fields: [pricingSchemeId], references: [inflowId], onDelete: Cascade)
  product           Product @relation(fields: [productId],references: [inflowId], onDelete: Cascade)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([pricingSchemeId, productId])

  @@index([pricingSchemeId])
  @@index([productId])

  @@map("product_price")
}

model ProductCostAdjustment {
  id                    String   @id @default(cuid())
  inflowId              String   @unique
  productId             String
  lastModifiedById      String?
  dateTime              DateTime
  serial                String?
  unitCost              Decimal  @db.Decimal(18,5)

  product               Product @relation(fields: [productId],references: [inflowId], onDelete: Cascade)
  lastModifiedBy        TeamMember? @relation(fields: [lastModifiedById],references: [inflowId], onDelete: SetNull)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([productId])
  @@index([lastModifiedById])
  @@index([dateTime])

  @@map("product_cost_adjustment")
}

model ProductBarcode {
  id            String @id @default(cuid())
  inflowId      String @unique
  productId     String
  barcode       String @unique
  lineNum       Int
  product       Product @relation(fields: [productId],references: [inflowId], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
  @@unique([productId, lineNum])

  @@map("product_barcode")
}

model ProductOperation {
  id                   String        @id @default(cuid())
  inflowId             String        @unique
  productId            String
  operationTypeId      String
  lineNum              Int
  cost                 Decimal       @db.Decimal(12, 4)
  estimatedPerHourCost Decimal       @db.Decimal(12, 4)
  estimatedSeconds     Decimal       @db.Decimal(12, 4)
  instructions         String?       @db.Text
  trackTime            Boolean       @default(false)
  timestamp            String?

  product              Product       @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  operationType        OperationType @relation(fields: [operationTypeId], references: [inflowId])

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([productId])
  @@index([operationTypeId])
  @@unique([productId, lineNum])
  @@map("product_operation")
}

model OperationType {
  id                   String             @id @default(cuid())
  inflowId             String             @unique
  name                 String
  estimatedPerHourCost Decimal            @db.Decimal(12, 4)
  isActive             Boolean            @default(true)
  isDefault            Boolean            @default(false)
  trackTime            Boolean            @default(false)
  timestamp            String?

  productOperations    ProductOperation[]

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("operation_type")
}

model ProductTaxCode {
  id             String       @id @default(cuid())
  productTaxCodeId String     @unique // Storing payload's productTaxCodeId explicitly
  productId      String
  taxCodeId      String
  taxingSchemeId String
  timestamp      String?

  product        Product      @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  taxCode        TaxCode      @relation(fields: [taxCodeId], references: [inflowId])
  taxingScheme   TaxingScheme @relation(fields: [taxingSchemeId], references: [inflowId])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([productId])
  @@index([taxCodeId])
  @@index([taxingSchemeId])
  @@unique([productId, taxCodeId])
  @@map("product_tax_code")
}

model ProductAttachment {
  id               String      @id @default(cuid())
  inflowId         String      @unique // Storing payload's attachmentId
  productId        String
  attachmentUrl    String
  fileName         String
  lastModDttm      DateTime?
  lastModifiedById String?

  product          Product     @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  lastModifiedBy   TeamMember? @relation(fields: [lastModifiedById], references: [inflowId])

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([productId])
  @@index([lastModifiedById])
  @@map("product_attachment")
}

model ProductCost {
  id            String   @id @default(cuid())
  inflowId      String   @unique // Storing payload's productCostId
  productId     String   @unique // Enforces 1:1 relation with Product
  cost          Decimal  @db.Decimal(12, 4)

  product       Product  @relation(fields: [productId], references: [inflowId], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("product_cost")
}

model reorderSetting {
  id                 String   @id @default(cuid())
  inflowId           String   @unique // Storing payload's reorderSettingsId
  productId          String
  locationId         String
  fromLocationId     String?
  vendorId           String?
  defaultSublocation String?
  enableReordering   Boolean  @default(true)
  reorderMethod      String   @default("PurchaseOrder") // e.g., PurchaseOrder, TransferOrder
  reorderPoint       Decimal  @db.Decimal(12, 4)
  reorderQuantity    Decimal  @db.Decimal(12, 4)
  timestamp          String?

  product            Product  @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  location           Location @relation("TargetLocation", fields: [locationId], references: [inflowId])
  fromLocation       Location? @relation("SourceLocation", fields: [fromLocationId], references: [inflowId])
  vendor             Vendor?   @relation(fields: [vendorId], references: [inflowId])

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId])
  @@index([locationId])
  @@index([fromLocationId])
  @@index([vendorId])
  @@map("product_reorder_setting")
}

model ProductBom {
  id             String   @id @default(cuid())
  inflowId       String   @unique // Storing payload's itemBomId
  productId      String   // The assembly/parent item
  childProductId String   // The component/child item
  quantity       Decimal  @db.Decimal(12, 4)
  timestamp      String?

  product        Product  @relation("ParentProduct", fields: [productId], references: [inflowId], onDelete: Cascade)
  childProduct   Product  @relation("ChildProduct", fields: [childProductId], references: [inflowId], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId])
  @@index([childProductId])
  @@unique([productId, childProductId])
  @@map("product_bom")
}

// =========================

model ProductUom {
  id               String @id @default(cuid())
  productId        String @unique
  uomId            String
  standardQuantity Decimal @db.Decimal(18,4)
  uomQuantity      Decimal @db.Decimal(18,4)
  product          Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  uom              UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@map("product_uom")
}

model ProductSalesUom {
  id               String @id @default(cuid())
  productId        String @unique
  uomId            String
  standardQuantity Decimal @db.Decimal(18,4)
  uomQuantity      Decimal @db.Decimal(18,4)
  product          Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  uom              UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@map("product_sales_uom")
}

model UnitOfMeasure {
  id         String @id @default(cuid())
  code       String @unique
  name       String
  category   UomCategory
  baseFactor Decimal @db.Decimal(18,6)
  isActive   Boolean @default(true)
  fromConversions UnitConversion[] @relation("FromUnit")
  toConversions   UnitConversion[] @relation("ToUnit")
  productSalesUoms ProductSalesUom[]
  productUoms      ProductUom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("unit_of_measure")
}

model UnitConversion {
  id        String @id @default(cuid())
  fromUomId String
  toUomId   String
  factor    Decimal @db.Decimal(18,6)
  fromUom   UnitOfMeasure @relation("FromUnit", fields: [fromUomId], references: [id])
  toUom     UnitOfMeasure @relation("ToUnit", fields: [toUomId], references: [id])

  @@unique([fromUomId, toUomId])
  @@map("unit_conversion")
}

enum UomCategory {
  COUNT
  WEIGHT
  VOLUME
  LENGTH
  AREA
}

model ProductImage {
  id                  String @id @default(cuid())
  inflowId            String @unique
  groupId             String?
  productId           String?
  position            Int @default(0)
  largeUrl            String?
  mediumUncroppedUrl  String?
  mediumUrl           String?
  originalUrl         String?
  smallUrl            String?
  thumbUrl            String?
  group               ProductGroup? @relation(fields: [groupId], references: [inflowId], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [inflowId], onDelete: Cascade)

  @@index([groupId, position])
  @@index([productId, position])

  @@map("product_image")
}

model Attribute {
  id        String @id @default(cuid())
  name      String @unique
  values    AttributeValue[]
  inflowOptions ProductGroupOption[]

  @@map("attribute")
}

model AttributeValue {
  id          String @id @default(cuid())
  value       String
  hexCode     String?
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  inflowValues ProductGroupOptionValue[]

  @@unique([attributeId, value])
}


model ProductVariantSelection {
  id                     String @id @default(cuid())
  variantId              String
  optionId               String
  optionValueId          String

  variant                ProductVariant @relation(fields: [variantId],references: [inflowId], onDelete: Cascade)
  option                 ProductGroupOption @relation(fields: [optionId],references: [inflowId], onDelete: Cascade)
  optionValue            ProductGroupOptionValue @relation(fields: [optionValueId], references: [inflowId], onDelete: Cascade)

  createdAt              DateTime @default(now())

  @@index([variantId])
  @@index([optionId])
  @@index([optionValueId])
  @@unique([variantId,optionId])

  @@map("product_variant_selection")
}

model ProductGroupOption {
  id                    String @id @default(cuid())
  inflowId              String @unique
  productGroupId        String
  lineNum               Int

  attributeId           String
  attribute             Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  productGroup          ProductGroup @relation(fields: [productGroupId],references: [inflowId], onDelete: Cascade)
  values                ProductGroupOptionValue[]
  variantSelections     ProductVariantSelection[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([productGroupId])
  @@unique([productGroupId, attributeId])

  @@map("product_group_option")
}

model ProductGroupOptionValue {
  id                     String @id @default(cuid())
  inflowId               String @unique
  optionId               String
  lineNum                Int

  attributeValueId       String
  attributeValue         AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  option                 ProductGroupOption @relation(fields: [optionId],references: [inflowId], onDelete: Cascade)
  variantSelections      ProductVariantSelection[]

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  
  
  @@index([optionId])
  @@unique([optionId, attributeValueId])
  @@unique([optionId, lineNum])

  @@map("product_group_option_value")
}


// customFields.custom2
model Feature {
  id          String @id @default(cuid())
  name        String @unique // e.g., "Sensor", "Max Resolution", "Weather Sealing"
  products    ProductFeature[]
  groups      ProductGroupFeature[]
  values      FeatureValue[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("feature")
}

model FeatureValue {
  id String @id @default(cuid())
  featureId String
  value String

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  products  ProductFeature[]
  groups    ProductGroupFeature[]

  @@unique([featureId, value])

  @@map("feature_value")
}

model ProductGroupFeature {
  groupId   String
  featureId String
  featureValueId String

  group          ProductGroup @relation(fields: [groupId], references: [inflowId], onDelete: Cascade)
  feature        Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureValue   FeatureValue @relation(fields: [featureValueId], references: [id], onDelete: Cascade)

  @@id([groupId, featureId])

  @@map("group_feature")
}

model ProductFeature {
  productId      String
  featureId      String
  featureValueId String
  
  product        Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  feature        Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureValue   FeatureValue @relation(fields: [featureValueId], references: [id], onDelete: Cascade)

  @@id([productId, featureId])

  @@map("product_feature")
}

// customFields.custom3
model Tag {
  id          String @id @default(cuid())
  name        String @unique
  products    ProductTag[]
  groups      ProductGroupTag[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tag")
}

model ProductGroupTag {
  groupId String
  tagId   String

  group          ProductGroup? @relation(fields: [groupId], references: [inflowId], onDelete: Cascade)
  tag   Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([groupId, tagId])

  @@map("group_tag")
}

model ProductTag {
  productId      String
  tagId          String

  product        Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  tag            Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])

  @@map("product_tag")
}


// Locations

model Location {
  id              String   @id @default(cuid())
  inflowId        String   @unique
  name            String
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)

  address             LocationAddress?
  inventories         Inventory[]
  sublocations        Sublocation[]
  adjustmentLines     InventoryAdjustmentLine[]
  inventoryLedger     InventoryLedger[]
  teamLocations       TeamMemberLocation[]
  customers           Customer[]
  salesOrders         SalesOrder[]
  purchaseOrders      PurchaseOrder[]
  
  outgoingTransfers TransferOrder[] @relation("TransferSourceLocation")
  incomingTransfers TransferOrder[]  @relation("TransferTargetLocation")
  reorderTargets reorderSetting[] @relation("TargetLocation")
  reorderSources reorderSetting[] @relation("SourceLocation")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deletedAt   DateTime?

  @@map("location")
}

model LocationAddress {
  id            String @id @default(cuid())
  locationId    String @unique
  address1      String?
  address2      String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  remarks       String?
  addressType   String?

  location      Location @relation(fields: [locationId],references: [inflowId], onDelete: Cascade)

  @@map("location_address")
}

model Sublocation {
  id              String @id @default(cuid())
  locationId      String
  name            String
  location        Location @relation(fields: [locationId],references: [inflowId], onDelete: Cascade)
  inventoryBins   InventoryBin[]
  sourceTransferLines TransferOrderLine[] @relation("TransferSourceSublocation")
  targetTransferLines TransferOrderLine[] @relation("TransferTargetSublocation")
  
  adjustmentLines     InventoryAdjustmentLine[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([locationId, name])
  @@index([locationId])

  @@map("sublocation")
}



model Inventory {
  id             String @id @default(cuid())
  productId      String
  locationId     String
  quantityOnHand Decimal @db.Decimal(18,4)
  
  quantityAvailable   Decimal? @db.Decimal(18,4)
  quantityReserved    Decimal? @db.Decimal(18,4)

  // 🚀 REPLENISHMENT CONTROL FIELDS ADDED HERE:
  reorderThreshold  Decimal  @default(0.0000) @db.Decimal(18,4) // Trigger point (e.g., alert if available < 10)
  reorderQuantity   Decimal  @default(0.0000) @db.Decimal(18,4) // Economic order size to auto-request
  isAutoReorderEnabled Boolean @default(false)                  // Automation switch flag
  preferredSourceLocationId String?

  product             Product @relation(fields: [productId],references: [inflowId], onDelete: Cascade)
  location            Location @relation(fields: [locationId],references: [inflowId], onDelete: Cascade)
  bins                InventoryBin[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])

  @@map("inventory")
}

model InventoryBin {
  id             String @id @default(cuid())
  inventoryId    String
  productId      String
  sublocationId  String
  quantity       Decimal @db.Decimal(18,4)

  inventory           Inventory @relation(fields: [inventoryId],references: [id], onDelete: Cascade)
  product             Product @relation(fields: [productId],references: [inflowId], onDelete: Cascade)
  sublocation         Sublocation @relation(fields: [sublocationId],references: [id], onDelete: Cascade)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([productId,sublocationId])

  @@map("inventory_bin")
}

model InventoryAdjustment {
  id                String   @id @default(cuid())
  adjustmentNumber  String   @unique
  reason            InventoryAdjustmentReason
  notes             String?
  performedById     String
  performedBy       User     @relation(fields: [performedById], references: [id], onDelete: Cascade)
  lines             InventoryAdjustmentLine[]
  createdAt         DateTime @default(now())
  @@map("inventory_adjustment")
}

model InventoryAdjustmentLine {
  id                    String @id @default(cuid())
  adjustmentId          String
  productId             String
  locationId            String
  sublocationId         String?
  quantityBefore        Decimal @db.Decimal(18,4)
  quantityAdjusted      Decimal @db.Decimal(18,4)
  quantityAfter         Decimal @db.Decimal(18,4)
  reason                String?
  adjustment            InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product               Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  location              Location @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  sublocation           Sublocation? @relation(fields: [sublocationId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())

  @@index([productId])
  @@index([locationId])

  @@map("inventory_adjustment_line")
}

enum InventoryAdjustmentReason {
  STOCK_COUNT
  DAMAGE
  LOSS
  THEFT
  EXPIRED
  RETURN
  CORRECTION
  MANUAL
}

// ADJUSTMENT REASON

model AdjustmentReason {
  id            String   @id @default(cuid())
  inflowId      String   @unique
  name          String
  isActive      Boolean  @default(true)
