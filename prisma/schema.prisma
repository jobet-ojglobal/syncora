// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SyncJob {
  id        String   @id @default(cuid())
  source    String
  status    String   @default("pending")
  progress  Int      @default(0)
  data      Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([status])
  @@index([createdAt])
  @@map("sync_job")
}

model Category {
  id                String   @id @default(cuid())
  inflowCategoryId  String   @unique
  name              String
  isDefault         Boolean  @default(false)
  timestamp         String?

  parentId          String?
  parent            Category?  @relation("CategoryToCategory", fields: [parentId], references: [inflowCategoryId])
  children          Category[] @relation("CategoryToCategory")

  productGroups     ProductGroup[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("category")
}

model ProductGroup {
  id                String   @id @default(cuid())
  inflowProdGroupId String   @unique
  name              String
  categoryId        String?
  defaultProductId  String?
  defaultImageId    String?
  isActive          Boolean
  timestamp         String?

  category          Category? @relation(fields: [categoryId], references: [inflowCategoryId])
  variants          ProductVariant[]
  images            ProductImage[]
  options           ProductGroupOption[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("product_group")
}

model ProductVariant {
  id                String   @id @default(cuid())
  inflowVariantId   String   @unique
  productGroupId    String
  productId         String   @unique
  defaultPrice      Decimal  @db.Decimal(18,5)

  group             ProductGroup @relation(fields: [productGroupId], references: [inflowProdGroupId])
  // product           Product      @relation(fields: [productId], references: [inflowProductId])
  product           Product  @relation(fields: [productId], references: [inflowProductId])
  selections        ProductVariantSelection[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([productGroupId])
  @@index([productId])
  @@map("product_variant")
}

model Product {
  id                      String   @id @default(cuid())
  inflowProductId         String   @unique
  sku                     String?
  name                    String
  description             String?
  itemType                String?
  autoAssemble            Boolean @default(false)
  isActive                Boolean @default(true)
  isManufacturable        Boolean @default(false)
  includeQuantityBuildable Boolean @default(false)
  standardUomName         String?
  trackExpiry             Boolean @default(false)
  trackLots               Boolean @default(false)
  trackSerials            Boolean @default(false)
  shelfLifeDays           Int?
  sellBeforeExpiryDays    Int?
  expiryNotificationDays  Int?
  weight                  Decimal? @db.Decimal(12,4)
  width                   Decimal? @db.Decimal(12,4)
  height                  Decimal? @db.Decimal(12,4)
  length                  Decimal? @db.Decimal(12,4)
  originCountry           String?
  hsTariffNumber          String?
  remarks                 String?
  lastVendorId            String?
  lastModifiedById        String?
  createdDttm            DateTime?
  lastModifiedDateTime   DateTime?
  timestamp              String?

  purchasingUom         ProductUom?
  salesUom              ProductSalesUom?
  variant               ProductVariant?
  images                ProductImage[]

  brandId           String?
  brand             Brand? @relation(fields: [brandId], references: [id])

  features          ProductFeature[]
  tags              ProductTag[]

  inventories             Inventory[]
  inventoryBins           InventoryBin[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("product")
}

model ProductUom {
  id                 String @id @default(cuid())
  productId          String @unique
  name               String
  standardQuantity   Decimal @db.Decimal(18,4)
  uomQuantity        Decimal @db.Decimal(18,4)
  product            Product @relation(fields: [productId], references: [inflowProductId])

  @@map("product_uom")
}

model ProductSalesUom {
  id                 String @id @default(cuid())
  productId          String @unique
  name               String
  standardQuantity   Decimal @db.Decimal(18,4)
  uomQuantity        Decimal @db.Decimal(18,4)
  product            Product @relation(fields: [productId], references: [inflowProductId])

  @@map("product_sales_uom")
}

model ProductImage {
  id                  String @id @default(cuid())
  inflowImageId       String @unique
  groupId             String?
  productId           String?
  position            Int @default(0)
  largeUrl            String?
  mediumUncroppedUrl  String?
  mediumUrl           String?
  originalUrl         String?
  smallUrl            String?
  thumbUrl            String?

  group               ProductGroup? @relation(fields: [groupId], references: [inflowProdGroupId])
  product             Product? @relation(fields: [productId], references: [inflowProductId])

  @@index([groupId, position])
  @@index([productId, position])

  @@map("product_image")
}

// customFields.custom1
model Brand {
  id          String @id @default(cuid())
  name        String @unique
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("brand")
}

// customFields.custom2
model Feature {
  id          String @id @default(cuid())
  name        String @unique
  products    ProductFeature[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature")
}

// customFields.custom3
model Tag {
  id          String @id @default(cuid())
  name        String @unique
  products    ProductTag[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tag")
}

model ProductFeature {
  productId      String
  featureId      String

  product        Product @relation(fields: [productId], references: [inflowProductId])
  feature        Feature @relation(fields: [featureId], references: [id])

  @@id([productId, featureId])

  @@map("product_feature")
}

model ProductTag {
  productId      String
  tagId          String

  product        Product @relation(fields: [productId], references: [inflowProductId])
  tag            Tag @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])

  @@map("product_tag")
}


model ProductGroupOption {
  id                    String @id @default(cuid())
  inflowId              String @unique
  productGroupId        String
  lineNum               Int
  name                  String
  productGroup          ProductGroup @relation(fields: [productGroupId],references: [inflowProdGroupId])
  values                ProductGroupOptionValue[]
  variantSelections     ProductVariantSelection[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([productGroupId])
  @@map("product_group_option")
}

model ProductGroupOptionValue {
  id                     String @id @default(cuid())
  inflowId               String @unique
  optionId               String
  lineNum                Int
  value                  String
  option                 ProductGroupOption @relation(fields: [optionId],references: [inflowId])
  variantSelections      ProductVariantSelection[]

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  
  @@index([optionId])
  @@map("product_group_option_value")
}

model ProductVariantSelection {
  id                     String @id @default(cuid())
  variantId              String
  optionId               String
  optionValueId          String

  variant                ProductVariant @relation(fields: [variantId],references: [inflowVariantId])
  option                 ProductGroupOption @relation(fields: [optionId],references: [inflowId])
  optionValue            ProductGroupOptionValue @relation(fields: [optionValueId],references: [inflowId])

  createdAt              DateTime @default(now())

  @@unique([variantId,optionId])
  @@map("product_variant_selection")
}

// Locations

model Location {
  id              String   @id @default(cuid())
  inflowId        String   @unique
  name            String
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  timestamp       String?

  address         LocationAddress?
  inventories     Inventory[]
  sublocations    Sublocation[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("location")
}

model LocationAddress {
  id            String @id @default(cuid())
  locationId    String @unique
  address1      String?
  address2      String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  remarks       String?
  addressType   String?

  location      Location @relation(fields: [locationId],references: [inflowId])
}

model Sublocation {
  id              String @id @default(cuid())
  locationId      String
  name            String
  location        Location @relation(fields: [locationId],references: [inflowId])
  inventoryBins   InventoryBin[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([locationId, name])
  @@index([locationId])

  @@map("sublocation")
}

model Inventory {
  id             String @id @default(cuid())
  productId      String
  locationId     String
  quantityOnHand Decimal @db.Decimal(18,4)
  
  quantityAvailable   Decimal? @db.Decimal(18,4)
  quantityReserved    Decimal? @db.Decimal(18,4)

  product             Product @relation(fields: [productId],references: [inflowProductId])
  location            Location @relation(fields: [locationId],references: [inflowId])

  bins                InventoryBin[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])

  @@map("inventory")
}

model InventoryBin {
  id             String @id @default(cuid())
  inventoryId    String
  productId      String
  sublocationId  String
  quantity       Decimal @db.Decimal(18,4)

  inventory           Inventory @relation(fields: [inventoryId],references: [id])
  product             Product @relation(fields: [productId],references: [inflowProductId])
  sublocation         Sublocation @relation(fields: [sublocationId],references: [id])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([productId,sublocationId])

  @@map("inventory_bin")
}



// Integrations

model WebhookSubscription {
  id          String   @id @default(cuid())
  provider    String   // "inflow"
  remoteId    String?  // ID from inFlow if they provide one
  url         String
  event       String
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("webhook_subscription")
}

model WebhookEvent {
  id          String   @id @default(cuid())

  provider    String
  eventType   String
  payload     Json

  processed   Boolean  @default(false)
  receivedAt  DateTime @default(now())

  @@index([provider, eventType])

  @@map("webhook_event")
}

model InflowWebhook {
  id                      String   @id
  url                     String

  secret                  String?
  events                  Json
  isDisabled              Boolean @default(false)
  consecutiveFailureCount Int     @default(0)
  lastFailureMessage      String?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("inflow_webhook")
}

model InflowIntegration {
  id          String   @id @default(cuid())
  webhookId   String?  @unique
  webhookUrl  String?
  secret      String?
  isConnected Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InflowWebhookEvent {
  id          String   @id @default(cuid())
  eventType   String
  payload     Json
  processed   Boolean @default(false)
  receivedAt  DateTime @default(now())

  @@index([eventType])
}