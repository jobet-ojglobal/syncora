// ==========================================
// Purchase Order Models
// ==========================================

model PurchaseOrder {
  id                     String    @id @default(cuid())
  inflowId               String    @unique
  orderNumber            String    @unique // e.g., "PO-000123"
  vendorOrderNumber      String?
  
  // Financials
  subTotal               Decimal   @db.Decimal(18, 5)
  total                  Decimal   @db.Decimal(18, 5)
  amountPaid             Decimal   @db.Decimal(18, 5)
  balance                Decimal   @db.Decimal(18, 5)
  freight                Decimal   @db.Decimal(18, 5)
  returnFee              Decimal   @db.Decimal(18, 5)
  returnExtra            Decimal   @db.Decimal(18, 5)
  exchangeRate           Float     @default(1.0)
  exchangeRateAutoPulled DateTime?

  // Statuses & Flags
  paymentStatus          String    // e.g., "Quote"
  inventoryStatus        String    // e.g., "Quote"
  isCancelled            Boolean   @default(false)
  isCompleted            Boolean   @default(false)
  isQuote                Boolean   @default(false)
  isTaxInclusive         Boolean   @default(false)
  showShipping           Boolean   @default(true)
  carrier                String?

  // Dates
  orderDate              DateTime?
  dueDate                DateTime?
  requestShipDate        DateTime?

  // Contact & Remarks
  contactName            String?
  email                  String?
  phone                  String?
  orderRemarks           String?   @db.Text
  receiveRemarks         String?   @db.Text
  returnRemarks          String?   @db.Text
  unstockRemarks         String?   @db.Text
  shipToCompanyName      String?
  timestamp              String

  // Embedded Structured JSON Data
  shipToAddress          Json?     // Stores complete address sub-object
  vendorAddress          Json?     // Stores complete address sub-object
  customFields           Json?     // Stores custom1 through custom10
  nonVendorCosts         Json?     // Stores { value: "19.99", isPercent: true }

  // Relations
  vendorId               String
  vendor                 Vendor    @relation(fields: [vendorId], references: [inflowId])

  locationId             String?
  location               Location? @relation(fields: [locationId], references: [inflowId])

  assignedToTeamMemberId String?
  assignedToTeamMember   TeamMember? @relation("POAssignedOrders", fields: [assignedToTeamMemberId], references: [inflowId])
  
  approverTeamMemberId   String?
  approverTeamMember     TeamMember? @relation("POApprovedOrders", fields: [approverTeamMemberId], references: [inflowId])

  lastModifiedById       String?
  currencyId             String?
  paymentTermsId         String?
  taxingSchemeId         String?

  // Tax Subfields
  calculateTax2OnTax1    Boolean   @default(false)
  tax1                   Decimal   @db.Decimal(18, 5)
  tax1Name               String?
  tax1OnShipping         Boolean   @default(false)
  tax1Rate               Decimal   @db.Decimal(18, 5)
  tax2                   Decimal   @db.Decimal(18, 5)
  tax2Name               String?
  tax2OnShipping         Boolean   @default(false)
  tax2Rate               Decimal   @db.Decimal(18, 5)

  // Dependents / Line Array Relations
  lines                  PurchaseOrderLine[]
  paymentLines           PurchaseOrderPaymentLine[]
  receiveLines           PurchaseOrderReceiveLine[]
  unstockLines           PurchaseOrderUnstockLine[]
  attachments            PurchaseOrderAttachment[]

  @@index([inflowId])
  @@index([orderNumber])
  @@index([vendorId])
  @@index([locationId])
  @@index([paymentStatus])
  @@index([orderDate])

  @@map("purchase_order")
}

model PurchaseOrderLine {
  purchaseOrderLineId String        @id @default(uuid())
  purchaseOrderId     String
  purchaseOrder       PurchaseOrder @relation(fields: [purchaseOrderId], references: [inflowId], onDelete: Cascade)

  productId           String
  product             Product       @relation(fields: [productId], references: [inflowId])
  
  vendorItemCode      String?
  description         String?       @db.Text
  unitPrice           Decimal       @db.Decimal(18, 5)
  subTotal            Decimal       @db.Decimal(18, 5)
  discount            Json?         // Holds { value: "19.99", isPercent: true }
  serviceCompleted    Boolean       @default(false)
  returnDate          DateTime?
  quantity            Json          // Holds standardQuantity, uomQuantity, uom, and serials

  // Product structural fallback fields tracking specs at PO generation
  productHeight       Decimal?      @db.Decimal(10, 4)
  productLength       Decimal?      @db.Decimal(10, 4)
  productWidth        Decimal?      @db.Decimal(10, 4)
  productWeight       Decimal?      @db.Decimal(10, 4)

  tax1Rate            Decimal       @db.Decimal(18, 5)
  tax2Rate            Decimal       @db.Decimal(18, 5)
  taxCodeId           String?
  timestamp           String

  @@index([purchaseOrderId])
  @@index([productId])

  @@map("purchase_order_line")
}

model PurchaseOrderReceiveLine {
  purchaseOrderReceiveLineId String        @id @default(uuid())
  purchaseOrderId            String
  purchaseOrder              PurchaseOrder @relation(fields: [purchaseOrderId], references: [inflowId], onDelete: Cascade)

  productId                  String
  product                    Product       @relation(fields: [productId], references: [inflowId])

  locationId                 String?
  sublocation                String?       // e.g., "C-19"
  receiveDate                DateTime?
  description                String?
  vendorItemCode             String?
  quantity                   Json          // Quantity structural wrapper object
  timestamp                  String

  productHeight              Decimal?      @db.Decimal(10, 4)
  productLength              Decimal?      @db.Decimal(10, 4)
  productWidth               Decimal?      @db.Decimal(10, 4)
  productWeight              Decimal?      @db.Decimal(10, 4)

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([locationId])

  @@map("purchase_order_receive_line")
}

model PurchaseOrderUnstockLine {
  purchaseOrderUnstockLineId String        @id @default(uuid())
  purchaseOrderId            String
  purchaseOrder              PurchaseOrder @relation(fields: [purchaseOrderId], references: [inflowId], onDelete: Cascade)

  productId                  String
  product                    Product       @relation(fields: [productId], references: [inflowId])

  locationId                 String?
  sublocation                String?
  unstockDate                DateTime?
  description                String?
  vendorItemCode             String?
  quantity                   Json
  timestamp                  String

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([locationId])

  @@map("purchase_order_unstock_line")
}

model PurchaseOrderPaymentLine {
  purchaseOrderPaymentHistoryLineId String        @id @default(uuid())
  purchaseOrderId                   String
  purchaseOrder                     PurchaseOrder @relation(fields: [purchaseOrderId], references: [inflowId], onDelete: Cascade)

  amount                            Decimal       @db.Decimal(18, 5)
  datePaid                          DateTime?
  paymentMethod                     String?
  paymentType                       String?       // e.g., "Payment"
  referenceNumber                   String?
  remarks                           String?       @db.Text
  timestamp                         String

  @@index([purchaseOrderId])

  @@map("purchase_order_payment_line")
}

model PurchaseOrderAttachment {
  attachmentId     String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [inflowId], onDelete: Cascade)
  attachmentUrl    String
  fileName         String
  fileSize         Json?         // Empty or structured size metadata
  lastModDttm      DateTime?
  lastModifiedById String?

  @@index([purchaseOrderId])

  @@map("purchase_order_attachment")
}

