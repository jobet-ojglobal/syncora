// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  // role          UserRole @default(Customer)
  // branchId      String?
  // branch        Branch?  @relation(fields: [branchId], references: [id])
  // cart          Cart?

  // sessions      Session[]
  // accounts      Account[]
  // orders        CustomerOrder[]
  // activities ActivityLog[]
  adjustments      InventoryAdjustment[]


  @@unique([email])
  @@map("user")
}

model SyncJob {
  id        String   @id @default(cuid())
  source    String
  status    String   @default("pending")
  progress  Int      @default(0)
  data      Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([status])
  @@index([createdAt])
  @@map("sync_job")
}


// customFields.custom1
model Brand {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  logoUrl     String?
  websiteUrl  String?

  products    Product[]
  groups      ProductGroup[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deletedAt   DateTime?

  @@map("brand")
}

model Category {
  id          String   @id @default(cuid())
  inflowId    String   @unique
  name        String
  slug        String   @unique // e.g., "digital-cameras"
  description String?
  imageUrl    String?

  // isDefault         Boolean  @default(false)
  // timestamp         String?

  parentId          String?
  parent            Category?  @relation("CategoryToCategory", fields: [parentId], references: [inflowId])
  children          Category[] @relation("CategoryToCategory")

  productGroups     ProductGroup[]
  products          Product[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("category")
}

  // defaultProduct    Product? @relation("GroupDefaultProduct",fields: [defaultProductId], references: [inflowId])
  // defaultProductId  String?
  // defaultImageId    String?
  // timestamp         String?

model ProductGroup {
  id                String   @id @default(cuid())
  inflowId String   @unique
  name              String
  slug              String   @unique 
  description       String?  @db.Text
  brandId           String?
  categoryId        String?
  isActive          Boolean

  brand             Brand?   @relation(fields: [brandId], references: [id])
  category          Category? @relation(fields: [categoryId], references: [inflowId])

  variants          ProductVariant[]
  images            ProductImage[]
  options           ProductGroupOption[]
  tags              ProductGroupTag[]
  features          ProductGroupFeature[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@map("product_group")
}

model ProductVariant {
  id                String   @id @default(cuid())
  sku               String?
  inflowId          String   @unique
  productGroupId    String
  productId         String   @unique
  defaultPrice      Decimal  @db.Decimal(18,5)
  isActive          Boolean @default(true)
  signature         String
  variantCount      Int @default(0)

  group             ProductGroup @relation(fields: [productGroupId], references: [inflowId], onDelete: Cascade)
  product           Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  selections        ProductVariantSelection[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([productGroupId, productId])
  @@unique([productGroupId, signature])
  @@index([productGroupId])
  @@index([productId])
  

  @@map("product_variant")
}

model Product {
  id                      String   @id @default(cuid())
  inflowId                String   @unique
  sku                     String?
  name                    String
  slug                    String   @unique 
  description             String?
  itemType                String?
  autoAssemble            Boolean @default(false)
  isActive                Boolean @default(true)
  isManufacturable        Boolean @default(false)
  includeQuantityBuildable Boolean @default(false)
  standardUomName         String?
  trackExpiry             Boolean @default(false)
  trackLots               Boolean @default(false)
  trackSerials            Boolean @default(false)
  shelfLifeDays           Int?
  sellBeforeExpiryDays    Int?
  expiryNotificationDays  Int?
  weight                  Decimal? @db.Decimal(12,4)
  width                   Decimal? @db.Decimal(12,4)
  height                  Decimal? @db.Decimal(12,4)
  length                  Decimal? @db.Decimal(12,4)
  originCountry           String?
  hsTariffNumber          String?
  remarks                 String?
  lastVendorId            String?
  lastModifiedById        String?
  createdDttm            DateTime?
  lastModifiedDateTime   DateTime?
  timestamp              String?

  purchasingUom         ProductUom?
  salesUom              ProductSalesUom?
  
  variant               ProductVariant?
  images                ProductImage[]

  brandId           String?
  brand             Brand? @relation(fields: [brandId], references: [id])

  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [inflowId])

  tags              ProductTag[]
  features          ProductFeature[]

  inventories       Inventory[]
  inventoryBins     InventoryBin[]
  adjustmentLines   InventoryAdjustmentLine[]

  inventoryLedger   InventoryLedger[]
  
  transferOrderLines  TransferOrderLine[]
  barcodes          ProductBarcode[]
  

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  deletedAt   DateTime?

  @@map("product")
}

model ProductBarcode {
  id                     String @id @default(cuid())
  inflowId String @unique
  productId              String
  barcode                String @unique
  lineNum                Int
  timestamp              String?
  product Product @relation(fields: [productId],references: [inflowId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@unique([productId, lineNum])

  @@map("product_barcode")
}

