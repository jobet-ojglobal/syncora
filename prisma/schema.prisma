// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  // role          UserRole @default(Customer)
  // branchId      String?
  // branch        Branch?  @relation(fields: [branchId], references: [id])
  // cart          Cart?

  // sessions      Session[]
  // accounts      Account[]
  // orders        CustomerOrder[]
  // activities ActivityLog[]
  adjustments      InventoryAdjustment[]


  @@unique([email])
  @@map("user")
}

model SyncJob {
  id        String   @id @default(cuid())
  source    String
  status    String   @default("pending")
  progress  Int      @default(0)
  data      Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([status])
  @@index([createdAt])
  @@map("sync_job")
}

model Category {
  id          String   @id @default(cuid())
  inflowId    String   @unique
  name        String
  slug        String   @unique // e.g., "digital-cameras"
  description String?
  imageUrl    String?

  // isDefault         Boolean  @default(false)
  // timestamp         String?

  parentId          String?
  parent            Category?  @relation("CategoryToCategory", fields: [parentId], references: [inflowId])
  children          Category[] @relation("CategoryToCategory")

  productGroups     ProductGroup[]
  products          Product[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("category")
}

model ProductGroup {
  id                String   @id @default(cuid())
  inflowId String   @unique
  name              String
  slug              String   @unique 
  description       String?  @db.Text
  brandId           String?
  categoryId        String?
  defaultProductId  String?
  defaultImageId    String?
  isActive          Boolean
  timestamp         String?

  brand             Brand?   @relation(fields: [brandId], references: [id])
  category          Category? @relation(fields: [categoryId], references: [inflowId])
  variants          ProductVariant[]
  images            ProductImage[]
  options           ProductGroupOption[]
  tags              ProductTag[]
  features          ProductFeature[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@map("product_group")
}

model ProductVariant {
  id                String   @id @default(cuid())
  inflowId   String   @unique
  productGroupId    String
  productId         String   @unique
  defaultPrice      Decimal  @db.Decimal(18,5)

  group             ProductGroup @relation(fields: [productGroupId], references: [inflowId])
  product           Product  @relation(fields: [productId], references: [inflowId])
  selections        ProductVariantSelection[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([productGroupId])
  @@index([productId])
  @@map("product_variant")
}

model Product {
  id                      String   @id @default(cuid())
  inflowId         String   @unique
  sku                     String?
  name                    String
  slug                    String   @unique 
  description             String?
  itemType                String?
  autoAssemble            Boolean @default(false)
  isActive                Boolean @default(true)
  isManufacturable        Boolean @default(false)
  includeQuantityBuildable Boolean @default(false)
  standardUomName         String?
  trackExpiry             Boolean @default(false)
  trackLots               Boolean @default(false)
  trackSerials            Boolean @default(false)
  shelfLifeDays           Int?
  sellBeforeExpiryDays    Int?
  expiryNotificationDays  Int?
  weight                  Decimal? @db.Decimal(12,4)
  width                   Decimal? @db.Decimal(12,4)
  height                  Decimal? @db.Decimal(12,4)
  length                  Decimal? @db.Decimal(12,4)
  originCountry           String?
  hsTariffNumber          String?
  remarks                 String?
  lastVendorId            String?
  lastModifiedById        String?
  createdDttm            DateTime?
  lastModifiedDateTime   DateTime?
  timestamp              String?

  purchasingUom         ProductUom?
  salesUom              ProductSalesUom?
  
  variant               ProductVariant?
  images                ProductImage[]

  brandId           String?
  brand             Brand? @relation(fields: [brandId], references: [id])

  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [inflowId])

  features          ProductFeature[]
  tags              ProductTag[]

  inventories       Inventory[]
  inventoryBins     InventoryBin[]
  adjustmentLines   InventoryAdjustmentLine[]

  inventoryLedger   InventoryLedger[]
  
  transferOrderLines  TransferOrderLine[]
  barcodes          ProductBarcode[]
  

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  deletedAt   DateTime?

  @@map("product")
}

model ProductBarcode {
  id                     String @id @default(cuid())
  inflowId String @unique
  productId              String
  barcode                String @unique
  lineNum                Int
  timestamp              String?
  product Product @relation(fields: [productId],references: [inflowId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@unique([productId, lineNum])

  @@map("product_barcode")
}

model ProductUom {
  id                 String @id @default(cuid())
  productId          String @unique
  name               String
  standardQuantity   Decimal @db.Decimal(18,4)
  uomQuantity        Decimal @db.Decimal(18,4)
  product            Product @relation(fields: [productId], references: [inflowId])

  @@map("product_uom")
}

model ProductSalesUom {
  id                 String @id @default(cuid())
  productId          String @unique
  name               String
  standardQuantity   Decimal @db.Decimal(18,4)
  uomQuantity        Decimal @db.Decimal(18,4)
  product            Product @relation(fields: [productId], references: [inflowId])

  @@map("product_sales_uom")
}

model ProductImage {
  id                  String @id @default(cuid())
  inflowId       String @unique
  groupId             String?
  productId           String?
  position            Int @default(0)
  largeUrl            String?
  mediumUncroppedUrl  String?
  mediumUrl           String?
  originalUrl         String?
  smallUrl            String?
  thumbUrl            String?

  group               ProductGroup? @relation(fields: [groupId], references: [inflowId])
  product             Product? @relation(fields: [productId], references: [inflowId])

  @@index([groupId, position])
  @@index([productId, position])

  @@map("product_image")
}

model ProductGroupOption {
  id                    String @id @default(cuid())
  inflowId              String @unique
  productGroupId        String
  lineNum               Int
  name                  String // e.g., "Color", "Configuration", "Lens Kit"

  attributeId           String?
  attribute             Attribute? @relation(fields: [attributeId], references: [id])

  productGroup          ProductGroup @relation(fields: [productGroupId],references: [inflowId])
  values                ProductGroupOptionValue[]
  variantSelections     ProductVariantSelection[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([productGroupId])
  @@map("product_group_option")
}

model ProductGroupOptionValue {
  id                     String @id @default(cuid())
  inflowId               String @unique
  optionId               String
  lineNum                Int
  value                  String

  attributeValueId       String?
  attributeValue         AttributeValue? @relation(fields: [attributeValueId], references: [id])

  option                 ProductGroupOption @relation(fields: [optionId],references: [inflowId])
  variantSelections      ProductVariantSelection[]

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  
  @@index([optionId])
  @@map("product_group_option_value")
}

model Attribute {
  id        String @id @default(cuid())
  name      String @unique
  values    AttributeValue[]
  inflowOptions ProductGroupOption[]

  @@map("attribute")
}

model AttributeValue {
  id          String @id @default(cuid())
  value       String
  hexCode     String?
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id])
  inflowValues ProductGroupOptionValue[]

  @@unique([attributeId, value])
}



model ProductVariantSelection {
  id                     String @id @default(cuid())
  variantId              String
  optionId               String
  optionValueId          String

  variant                ProductVariant @relation(fields: [variantId],references: [inflowId])
  option                 ProductGroupOption @relation(fields: [optionId],references: [inflowId])
  optionValue            ProductGroupOptionValue @relation(fields: [optionValueId],references: [inflowId])

  createdAt              DateTime @default(now())

  @@unique([variantId,optionId])
  @@map("product_variant_selection")
}

// customFields.custom1
model Brand {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  logoUrl     String?
  websiteUrl  String?

  products    Product[]
  groups      ProductGroup[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deletedAt   DateTime?

  @@map("brand")
}

// customFields.custom2
model Feature {
  id          String @id @default(cuid())
  name        String @unique // e.g., "Sensor", "Max Resolution", "Weather Sealing"
  products    ProductFeature[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature")
}

// customFields.custom3
model Tag {
  id          String @id @default(cuid())
  name        String @unique
  products    ProductTag[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tag")
}

model ProductFeature {
  productId      String
  groupId        String?
  featureId      String
  value          String // 👈 Added: Holds the dynamic value constraint (e.g., "Full Frame", "8K 30p", "Yes")
  
  group          ProductGroup? @relation(fields: [groupId], references: [inflowId])
  product        Product @relation(fields: [productId], references: [inflowId])
  feature        Feature @relation(fields: [featureId], references: [id])

  @@id([productId, featureId])

  @@map("product_feature")
}

model ProductTag {
  productId      String
  groupId        String?
  tagId          String

  group          ProductGroup? @relation(fields: [groupId], references: [inflowId])
  product        Product @relation(fields: [productId], references: [inflowId])
  tag            Tag @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])

  @@map("product_tag")
}


// Locations

model Location {
  id              String   @id @default(cuid())
  inflowId        String   @unique
  name            String
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  timestamp       String?

  address         LocationAddress?
  inventories     Inventory[]
  sublocations    Sublocation[]
  adjustmentLines     InventoryAdjustmentLine[]
  inventoryLedger     InventoryLedger[]
  
  outgoingTransfers TransferOrder[] @relation("TransferSourceLocation")
  incomingTransfers TransferOrder[]  @relation("TransferTargetLocation")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deletedAt   DateTime?

  @@map("location")
}

model LocationAddress {
  id            String @id @default(cuid())
  locationId    String @unique
  address1      String?
  address2      String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  remarks       String?
  addressType   String?

  location      Location @relation(fields: [locationId],references: [inflowId])

  

  @@map("location_address")
}

model Sublocation {
  id              String @id @default(cuid())
  locationId      String
  name            String
  location        Location @relation(fields: [locationId],references: [inflowId])
  inventoryBins   InventoryBin[]
  sourceTransferLines TransferOrderLine[] @relation("TransferSourceSublocation")
  targetTransferLines TransferOrderLine[] @relation("TransferTargetSublocation")
  
  adjustmentLines     InventoryAdjustmentLine[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([locationId, name])
  @@index([locationId])

  @@map("sublocation")
}

model Inventory {
  id             String @id @default(cuid())
  productId      String
  locationId     String
  quantityOnHand Decimal @db.Decimal(18,4)
  
  quantityAvailable   Decimal? @db.Decimal(18,4)
  quantityReserved    Decimal? @db.Decimal(18,4)

  product             Product @relation(fields: [productId],references: [inflowId])
  location            Location @relation(fields: [locationId],references: [inflowId])
  bins                InventoryBin[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])

  @@map("inventory")
}

model InventoryBin {
  id             String @id @default(cuid())
  inventoryId    String
  productId      String
  sublocationId  String
  quantity       Decimal @db.Decimal(18,4)

  inventory           Inventory @relation(fields: [inventoryId],references: [id])
  product             Product @relation(fields: [productId],references: [inflowId])
  sublocation         Sublocation @relation(fields: [sublocationId],references: [id])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([productId,sublocationId])

  @@map("inventory_bin")
}

model InventoryAdjustment {
  id                String   @id @default(cuid())
  adjustmentNumber  String   @unique
  reason            AdjustmentReason
  notes             String?
  performedById     String
  performedBy       User     @relation(fields: [performedById], references: [id])
  lines             InventoryAdjustmentLine[]
  createdAt         DateTime @default(now())
  @@map("inventory_adjustment")
}

model InventoryAdjustmentLine {
  id                    String @id @default(cuid())
  adjustmentId          String
  productId             String
  locationId            String
  sublocationId         String?
  quantityBefore        Decimal @db.Decimal(18,4)
  quantityAdjusted      Decimal @db.Decimal(18,4)
  quantityAfter         Decimal @db.Decimal(18,4)
  reason                String?
  adjustment            InventoryAdjustment @relation(fields: [adjustmentId], references: [id])
  product               Product @relation(fields: [productId], references: [inflowId])
  location              Location @relation(fields: [locationId], references: [inflowId])
  sublocation           Sublocation? @relation(fields: [sublocationId], references: [id])
  createdAt             DateTime @default(now())

  @@index([productId])
  @@index([locationId])

  @@map("inventory_adjustment_line")
}

enum AdjustmentReason {
  STOCK_COUNT
  DAMAGE
  LOSS
  THEFT
  EXPIRED
  RETURN
  CORRECTION
  MANUAL
}

model InventoryLedger {
  id                String @id @default(cuid())
  productId         String
  locationId        String
  sublocationId     String?
  transactionType   InventoryTransactionType
  referenceType     String?
  referenceId       String?
  quantityChange    Decimal @db.Decimal(18,4)
  quantityBefore    Decimal @db.Decimal(18,4)
  quantityAfter     Decimal @db.Decimal(18,4)
  performedById     String?
  createdAt         DateTime @default(now())
  product           Product @relation(fields: [productId], references: [inflowId])
  location          Location @relation(fields: [locationId], references: [inflowId])
}

enum InventoryTransactionType {
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  PURCHASE
  SALE
  RETURN
}


model TransferOrder {
  id                String   @id @default(cuid())
  transferNumber    String   @unique
  sourceLocationId  String
  targetLocationId  String
  status            TransferOrderStatus @default(DRAFT)
  remarks           String?
  transferredAt     DateTime?
  receivedAt        DateTime?

  sourceLocation    Location @relation("TransferSourceLocation",fields: [sourceLocationId],references: [inflowId])
  targetLocation    Location @relation("TransferTargetLocation",fields: [targetLocationId],references: [inflowId])
  lines             TransferOrderLine[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sourceLocationId])
  @@index([targetLocationId])

  @@map("transfer_order")
}

model TransferOrderLine {
  id                    String @id @default(cuid())
  transferOrderId       String
  productId             String
  sourceSublocationId   String?
  targetSublocationId   String?
  quantity              Decimal @db.Decimal(18,4)

  transferOrder         TransferOrder @relation(fields: [transferOrderId],references: [id])
  product               Product @relation(fields: [productId],references: [inflowId])
  sourceSublocation     Sublocation? @relation("TransferSourceSublocation",fields: [sourceSublocationId],references: [id])
  targetSublocation     Sublocation? @relation("TransferTargetSublocation",fields: [targetSublocationId],references: [id])

  createdAt             DateTime @default(now())

  @@index([transferOrderId])
  @@index([productId])

  @@map("transfer_order_line")
}

enum TransferOrderStatus {
  DRAFT
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}



