model SalesOrder {
  id                     String    @id @default(cuid())
  inflowId               String    @unique
  localId                Int      @unique @default(autoincrement())
  orderNumber            String    @unique
  poNumber               String?
  externalId             String?
  source                 String?
  
  // Financials
  subTotal               Decimal   @db.Decimal(18, 5)
  total                  Decimal   @db.Decimal(18, 5)
  amountPaid             Decimal   @db.Decimal(18, 5)
  balance                Decimal   @db.Decimal(18, 5)
  orderFreight           Decimal   @db.Decimal(18, 5)
  returnFee              Decimal   @db.Decimal(18, 5)
  returnFreight          Decimal   @db.Decimal(18, 5)
  exchangeRate           Decimal   @default(1.0) @db.Decimal(18, 10)
