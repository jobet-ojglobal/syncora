model ProductBomLocationMap {
  id             String       @id @default(cuid())
  productBomId   String       // References ProductBom.inflowId
  locationId     String       // References your Location table identifier
  localId        Int          // The unique INT assigned by that specific local database

  location       Location? @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  productBom     ProductBom   @relation(fields: [productBomId], references: [inflowId], onDelete: Cascade)

  @@unique([productBomId, locationId])
  @@index([locationId, localId])
  @@map("product_bom_location_map")
}

// =========================

model PurchasingUom {
  id               String @id @default(cuid())
  productId        String @unique
  uomId            String
  standardQuantity Decimal @db.Decimal(18,4)
  uomQuantity      Decimal @db.Decimal(18,4)
  product          Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  uom              UnitOfMeasure @relation(fields: [uomId], references: [id], onDelete: Cascade)

  @@map("purchasing_uom")
}

model SalesUom {
  id               String @id @default(cuid())
  productId        String @unique
  uomId            String
  standardQuantity Decimal @db.Decimal(18,4)
  uomQuantity      Decimal @db.Decimal(18,4)
  product          Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  uom              UnitOfMeasure @relation(fields: [uomId], references: [id], onDelete: Cascade)

  @@map("sales_uom")
}

model UnitOfMeasure {
  id         String @id @default(cuid())
  code       String @unique
  name       String
  category   UomCategory
  baseFactor Decimal @db.Decimal(18,6)
  isActive   Boolean @default(true)
  fromConversions UnitConversion[] @relation("FromUnit")
  toConversions   UnitConversion[] @relation("ToUnit")
  salesUoms       SalesUom[]
  purchasingUoms  PurchasingUom[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@map("unit_of_measure")
}

model UnitConversion {
  id        String @id @default(cuid())
  fromUomId String
  toUomId   String
  factor    Decimal @db.Decimal(18,6)
  fromUom   UnitOfMeasure @relation("FromUnit", fields: [fromUomId], references: [id])
  toUom     UnitOfMeasure @relation("ToUnit", fields: [toUomId], references: [id])

  @@unique([fromUomId, toUomId])
  @@map("unit_conversion")
}

enum UomCategory {
  COUNT
  WEIGHT
  VOLUME
  LENGTH
  AREA
}

model ProductImage {
  id                  String @id @default(cuid())
  inflowId            String @unique
  groupId             String?
  productId           String?
  position            Int @default(0)
  largeUrl            String?
  mediumUncroppedUrl  String?
  mediumUrl           String?
  originalUrl         String?
  smallUrl            String?
  thumbUrl            String?
  group               ProductGroup? @relation(fields: [groupId], references: [inflowId], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [inflowId], onDelete: Cascade)

  localMappings       ProductImageLocationMap[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([groupId, position])
  @@index([productId, position])

  @@map("product_image")
}

model ProductImageLocationMap {
  id             String       @id @default(cuid())
  productImageId String       // References ProductImage.inflowId
  locationId     String       // References your Location table identifier
  localId        Int          // The unique INT assigned by that specific local database
  imageUrl       String?

  location       Location? @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  productImage   ProductImage @relation(fields: [productImageId], references: [inflowId], onDelete: Cascade)

  @@unique([productImageId, locationId])
  @@index([locationId, localId])
  @@map("product_image_location_map")
}

model Attribute {
  id        String @id @default(cuid())
  name      String @unique
  values    AttributeValue[]
  inflowOptions ProductGroupOption[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@map("attribute")
}

model AttributeValue {
  id          String @id @default(cuid())
  value       String
  hexCode     String?
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  inflowValues ProductGroupOptionValue[]

  @@unique([attributeId, value])
}


model ProductVariantSelection {
  id                     String @id @default(cuid())
  variantId              String
  optionId               String
  optionValueId          String

  variant                ProductVariant @relation(fields: [variantId],references: [inflowId], onDelete: Cascade)
  option                 ProductGroupOption @relation(fields: [optionId],references: [inflowId], onDelete: Cascade)
  optionValue            ProductGroupOptionValue @relation(fields: [optionValueId], references: [inflowId], onDelete: Cascade)

  createdAt              DateTime @default(now())

  @@index([variantId])
  @@index([optionId])
  @@index([optionValueId])
  @@unique([variantId,optionId])

  @@map("product_variant_selection")
}

model ProductGroupOption {
  id                    String @id @default(cuid())
  inflowId              String @unique
  productGroupId        String
  lineNum               Int

  attributeId           String
  attribute             Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  productGroup          ProductGroup @relation(fields: [productGroupId],references: [inflowId], onDelete: Cascade)
  values                ProductGroupOptionValue[]
  variantSelections     ProductVariantSelection[]
  localMappings         ProductGroupOptionLocationMap[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([productGroupId])
  @@unique([productGroupId, attributeId])

  @@map("product_group_option")
}

model ProductGroupOptionLocationMap {
  id                    String       @id @default(cuid())
  productGroupOptionId  String       // References ProductGroupOption.inflowId
  locationId            String       // References your Location table identifier
  localId               Int          // The unique INT assigned by that specific local database

  location              Location? @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  productGroupOption    ProductGroupOption @relation(fields: [productGroupOptionId], references: [inflowId], onDelete: Cascade)

  @@unique([productGroupOptionId, locationId])
  @@index([locationId, localId])
  @@map("product_group_option_location_map")
}

model ProductGroupOptionValue {
  id                     String @id @default(cuid())
  inflowId               String @unique
  optionId               String
  lineNum                Int

  attributeValueId       String
  attributeValue         AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  option                 ProductGroupOption @relation(fields: [optionId],references: [inflowId], onDelete: Cascade)
  variantSelections      ProductVariantSelection[]
  localMappings          ProductGroupOptionValueLocationMap[]

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  
  
  @@index([optionId])
  @@unique([optionId, attributeValueId])
  @@unique([optionId, lineNum])

  @@map("product_group_option_value")
}

model ProductGroupOptionValueLocationMap {
  id                        String       @id @default(cuid())
  productGroupOptionValueId String       // References ProductGroupOptionValue.inflowId
  locationId                String       // References your Location table identifier
  localId                   Int          // The unique INT assigned by that specific local database

  location                  Location? @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  productGroupOptionValue   ProductGroupOptionValue @relation(fields: [productGroupOptionValueId], references: [inflowId], onDelete: Cascade)

  @@unique([productGroupOptionValueId, locationId])
  @@index([locationId, localId])
  @@map("product_group_option_value_location_map")
}

// customFields.custom2
model Feature {
  id          String @id @default(cuid())
  name        String @unique // e.g., "Sensor", "Max Resolution", "Weather Sealing"
  products    ProductFeature[]
  groups      ProductGroupFeature[]
  values      FeatureValue[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("feature")
}

model FeatureValue {
  id String @id @default(cuid())
  featureId String
  value String

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  products  ProductFeature[]
  groups    ProductGroupFeature[]

  @@unique([featureId, value])

  @@map("feature_value")
}

model ProductGroupFeature {
  groupId   String
  featureId String
  featureValueId String

  group          ProductGroup @relation(fields: [groupId], references: [inflowId], onDelete: Cascade)
  feature        Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureValue   FeatureValue @relation(fields: [featureValueId], references: [id], onDelete: Cascade)

  @@id([groupId, featureId])

  @@map("group_feature")
}

model ProductFeature {
  productId      String
  featureId      String
  featureValueId String
  
  product        Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  feature        Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureValue   FeatureValue @relation(fields: [featureValueId], references: [id], onDelete: Cascade)

  @@id([productId, featureId])

  @@map("product_feature")
}

// customFields.custom3
model Tag {
  id          String @id @default(cuid())
  name        String @unique
  products    ProductTag[]
  groups      ProductGroupTag[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tag")
}

model ProductGroupTag {
  groupId String
  tagId   String

  group          ProductGroup? @relation(fields: [groupId], references: [inflowId], onDelete: Cascade)
  tag   Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([groupId, tagId])

  @@map("group_tag")
}

model ProductTag {
  productId      String
  tagId          String

  product        Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  tag            Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])

  @@map("product_tag")
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum LocationType {
  WAREHOUSE
  STORE
  FULFILLMENT_CENTER
  TRANSIT
}

// Locations

model Location {
  id              String   @id @default(cuid())
  inflowId        String   @unique
  name            String
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  locationType    LocationType  @default(STORE)
  status          LocationStatus @default(ACTIVE)
  url             String?
  imageUrl        String?
  
  address             LocationAddress?
  inventories         Inventory[]
  inventoryBinItems   InventoryBinItem[]
  sublocations        Sublocation[]
  linkedSublocation   Sublocation[] @relation("LocationLink")
  adjustmentLines     InventoryAdjustmentLine[]
  inventoryLedger     InventoryLedger[]
  teamLocations       TeamMemberLocation[]
  customers           Customer[]
  salesOrders         SalesOrder[]
  purchaseOrders      PurchaseOrder[]

  ledgerFromLocations InventoryLedger[] @relation("LedgerFromLocation")
  ledgerToLocations   InventoryLedger[] @relation("LedgerToLocation")
  
  outgoingTransfers TransferOrder[] @relation("TransferSourceLocation")
  incomingTransfers TransferOrder[]  @relation("TransferTargetLocation")
  reorderTargets    ReorderSetting[] @relation("TargetLocation")
  reorderSources    ReorderSetting[] @relation("SourceLocation")
  webhooks          LocationWebhook[]

  inventoryPreferredSource   Inventory[]  @relation("PreferredReplenishmentLocation")    

  stockAdjustments  StockAdjustment[]

  localTaxingSchemeMappings  TaxingSchemeLocationMap[]
  localTaxCodeMappings       TaxCodeLocationMap[]
  localCategoryMappings      CategoryLocationMap[]
  localProductGroupMappings  ProductGroupLocationMap[]
  localProductVariantMappings ProductVariantLocationMap[]
  localProductMappings       ProductLocationMap[]
  localProductPriceMappings  ProductPriceLocationMap[]
  localProductCostAdjustmentMappings ProductCostAdjustmentLocationMap[]
  localProductBarcodeMappings ProductBarcodeLocationMap[]
  localProductOperationMappings ProductOperationLocationMap[]
  localOperationTypeMappings OperationTypeLocationMap[]
  localProductAttachmentMappings ProductAttachmentLocationMap[]
  localProductCostMappings   ProductCostLocationMap[]
  localReorderSettingMappings ReorderSettingLocationMap[]
  localProductBomMappings    ProductBomLocationMap[]
  localProductImageMappings  ProductImageLocationMap[]
  localProductGroupOptionMappings ProductGroupOptionLocationMap[]
  localProductGroupOptionValueMappings ProductGroupOptionValueLocationMap[]
  localCurrencyMappings      CurrencyLocationMap[]
  localPricingSchemeMappings PricingSchemeLocationMap[]
  localPaymentTermMappings   PaymentTermLocationMap[]
  localTeamMemberMappingsExtended TeamMemberLocationMapExtended[]
  localCustomerMappings      CustomerLocationMap[]
  localCustomerDueMappings   CustomerDueLocationMap[]
  localCustomerBalanceMappings CustomerBalanceLocationMap[]
  localCustomerCreditMappings CustomerCreditLocationMap[]
  localVendorMappings        VendorLocationMap[]
  localVendorAttachmentMappings VendorAttachmentLocationMap[]
  localVendorItemMappings    VendorItemLocationMap[]
  localVendorDueMappings     VendorDueLocationMap[]
  localVendorBalanceMappings VendorBalanceLocationMap[]
  localVendorCreditMappings  VendorCreditLocationMap[]
  localSalesOrderMappings    SalesOrderLocationMap[]
  localPurchaseOrderMappings PurchaseOrderLocationMap[]
  sublocationLocalMappings SublocationLocationMap[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt   DateTime?

  @@map("location")
}

model LocationAddress {
  id            String @id @default(cuid())
  locationId    String @unique
  address1      String?
  address2      String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  remarks       String?

  location      Location @relation(fields: [locationId],references: [inflowId], onDelete: Cascade)

  @@map("location_address")
}

model Sublocation {
  id              String @id @default(cuid())
  locationId      String
  name            String

  location        Location @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  inventoryBins   InventoryBin[]
  sourceTransferLines TransferOrderLine[] @relation("TransferSourceSublocation")
  targetTransferLines TransferOrderLine[] @relation("TransferTargetSublocation")
  
  linkedLocationId     String?
  linkedLocation       Location? @relation("LocationLink", fields: [linkedLocationId], references: [inflowId], onDelete: SetNull)
  
  localMappings       SublocationLocationMap[]
  inventoryLedgers    InventoryLedger[]
  
  adjustmentLineBins  InventoryAdjustmentLineBin[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([locationId, name])
  @@index([locationId])

  @@map("sublocation")
}

model SublocationLocationMap {
  id            String      @id @default(cuid())
  sublocationId String      // References Mid-Server Sublocation.id (or inflowId/name depending on keys)
  locationId    String      // References parent Mid-Server Location.inflowId
  localId       Int         // The flat locationId (Int) on the Local Server database

  // Relations
  location      Location    @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  sublocation   Sublocation @relation(fields: [sublocationId], references: [id], onDelete: Cascade)

  // Enforce that a mid-server sublocation maps to exactly one local flat location ID
  @@unique([sublocationId, locationId])
  @@index([locationId, localId])
  @@map("sublocation_location_map")
}

model Inventory {
  id                         String    @id @default(cuid())
  productId                  String
  locationId                 String
  quantityOnHand             Decimal   @db.Decimal(18, 4)
  quantityAvailable          Decimal?  @db.Decimal(18, 4)
  quantityReserved           Decimal?  @db.Decimal(18, 4)

  reorderThreshold           Decimal   @default(0.0000) @db.Decimal(18, 4)
  reorderQuantity            Decimal   @default(0.0000) @db.Decimal(18, 4)
  isAutoReorderEnabled       Boolean   @default(false)

  preferredSourceLocationId  String?
  preferredSourceLocation    Location? @relation("PreferredReplenishmentLocation", fields: [preferredSourceLocationId], references: [inflowId])

  product                    Product   @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  location                   Location  @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  bins                       InventoryBin[]
  reservations               InventoryReservation[]

  lastCountedAt              DateTime?
  lastMovementAt             DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
  @@map("inventory")
}

model InventoryBin {
  id            String      @id @default(cuid())
  inventoryId   String
  sublocationId String
  quantity      Decimal     @db.Decimal(18, 4)

  inventory     Inventory   @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  sublocation   Sublocation @relation(fields: [sublocationId], references: [id], onDelete: Cascade)

  adjustmentSerialsFrom InventoryAdjustmentSerial[] @relation("AdjustmentSerialFromBin")
  adjustmentSerialsTo InventoryAdjustmentSerial[] @relation("AdjustmentSerialToBin")

  inventoryBinItems     InventoryBinItem[]
  adjustmentLines       InventoryAdjustmentLine[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([inventoryId, sublocationId])
  @@index([inventoryId])
  @@index([sublocationId])
  @@map("inventory_bin")
}

model InventoryBinItem {
  id            String      @id @default(cuid())
  productId     String
  locationId    String
  inventoryBinId  String?
  serialNumber  String      @unique
  status        SerialStatus @default(IN_STOCK)

  product       Product     @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  location      Location    @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  inventoryBin  InventoryBin? @relation(fields: [inventoryBinId], references: [id], onDelete: SetNull)

  ledgerEntries InventoryLedger[]
  adjustmentSerials     InventoryAdjustmentSerial[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([productId, locationId])
  @@map("inventory_bin_item")
}

enum SerialStatus {
  IN_STOCK
  RESERVED
  SOLD
  DAMAGED
  VOIDED
}

model AdjustmentReason {
  id            String   @id @default(cuid())
  inflowId      String   @unique
  name          String
  isActive      Boolean  @default(true)
  isInternal    Boolean  @default(false)

  stockAdjustments  StockAdjustment[]
  inventoryAdjustments    InventoryAdjustment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([name])

  @@map("adjustment_reason")
}

enum AdjustmentStatus {
  DRAFT
  POSTED
  VOIDED
  REVERTED
}

model InventoryAdjustment {
  id                    String                @id @default(cuid())
  inflowId              String                @unique
  adjustmentNumber      String                @unique

  adjustmentReasonId    String?
  remarks               String?

  performedById     String
  performedBy       TeamMember?               @relation("PerformedAdjustment", fields: [performedById], references: [inflowId], onDelete: Cascade)

  lastModifiedById     String?
  lastModifiedBy       TeamMember?            @relation("ModifiedAdjustment", fields: [lastModifiedById], references: [inflowId], onDelete: SetNull)

  adjustmentReason  AdjustmentReason?         @relation(fields: [adjustmentReasonId], references: [inflowId])

  lines             InventoryAdjustmentLine[]
  status            AdjustmentStatus          @default(DRAFT)

  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@map("inventory_adjustment")
}

model InventoryAdjustmentLine {
  id               String   @id @default(cuid())
  inflowId         String   @unique
  adjustmentId     String
  inventoryId      String?
  productId        String
  locationId       String
  inventoryBinId   String? 

  quantityBefore   Decimal  @db.Decimal(18, 4)
  quantityAdjusted Decimal  @db.Decimal(18, 4) // Can be positive (+) or negative (-)
  quantityAfter    Decimal  @db.Decimal(18, 4)
  quantityReserved Decimal? @db.Decimal(18, 4)

  reason           InventoryAdjustmentLineReason?
  description      String?

  adjustment       InventoryAdjustment       @relation(fields: [adjustmentId], references: [inflowId], onDelete: Cascade)
  product          Product                   @relation(fields: [productId], references: [inflowId], onDelete: Cascade) // Restrict
  location         Location                  @relation(fields: [locationId], references: [inflowId], onDelete: Cascade) // Restrict
  inventoryBin     InventoryBin?             @relation(fields: [inventoryBinId], references: [id], onDelete: SetNull)

  // Track exact serial numbers modified by this adjustment line
  serials          InventoryAdjustmentSerial[]
  draftBins        InventoryAdjustmentLineBin[]

  createdAt        DateTime                  @default(now())

  @@index([adjustmentId])
  @@index([productId])
  @@index([locationId])
  @@index([inventoryBinId])
  @@map("inventory_adjustment_line")
}

enum InventoryAdjustmentLineReason {
  STOCK_COUNT
  DAMAGE
  LOSS
  THEFT
  EXPIRED
  RETURN
  CORRECTION
  MANUAL
}

model InventoryAdjustmentLineBin {
  id                  String   @id @default(uuid())
  adjustmentLineId    String
  sublocationId       String
  quantity            Decimal

  adjustmentLine      InventoryAdjustmentLine @relation(fields: [adjustmentLineId], references: [id], onDelete: Cascade)
  sublocation         Sublocation              @relation(fields: [sublocationId], references: [id])

  serials          InventoryAdjustmentSerial[]

  @@index([adjustmentLineId])
  @@index([sublocationId])
  @@map("inventory_adjustment_line_bin")
}

model InventoryAdjustmentSerial {
  id                  String @id @default(cuid())
  adjustmentLineId    String
  draftBinId          String?
  inventoryBinItemId  String?
  serialNumber        String
  action              InventorySerialAdjustmentAction

  fromInventoryBinId  String?
  toInventoryBinId    String?

  adjustmentLine      InventoryAdjustmentLine @relation(fields: [adjustmentLineId], references: [id], onDelete: Cascade)
  draftBin           InventoryAdjustmentLineBin? @relation(fields: [draftBinId], references: [id], onDelete: Cascade)
  inventoryBinItem    InventoryBinItem? @relation(fields: [inventoryBinItemId], references: [id], onDelete: SetNull)
  fromInventoryBin    InventoryBin? @relation("AdjustmentSerialFromBin", fields: [fromInventoryBinId], references: [id], onDelete: SetNull)
  toInventoryBin      InventoryBin? @relation("AdjustmentSerialToBin", fields: [toInventoryBinId], references: [id], onDelete: SetNull)

  @@index([adjustmentLineId])
  @@index([draftBinId])
  @@index([inventoryBinItemId])
  @@index([fromInventoryBinId])
  @@index([toInventoryBinId])
  @@index([serialNumber])

  @@map("inventory_adjustment_serial")
}

enum InventorySerialAdjustmentAction {
  ADD
  REMOVE
  MOVE
  VERIFY
}

// Inventory Ledgers

model InventoryLedger {
  id               String                   @id @default(cuid())
  productId        String
  locationId       String
  sublocationId    String?                  // null = Unassigned / Floor stock
  
  transactionType  InventoryTransactionType
  referenceType    InventoryReferenceType?
  referenceId      String?
  performedById    String?

  fromLocationId   String?
  toLocationId     String?
  fromSublocationId String?
  toSublocationId  String?

  batchNumber      String?
  inventoryBinItemId  String?               // Set if transaction relates to a specific serial
  uomName          String?

  quantityChange   Decimal                  @db.Decimal(18, 4)
  quantityBefore   Decimal                  @db.Decimal(18, 4)
  quantityAfter    Decimal                  @db.Decimal(18, 4)

  unitCost         Decimal?                 @db.Decimal(18, 5)
  totalCost        Decimal?                 @db.Decimal(18, 5)

  remarks          String?

  product          Product                  @relation(fields: [productId], references: [inflowId], onDelete: Cascade) // Restrict
  location         Location                 @relation(fields: [locationId], references: [inflowId], onDelete: Cascade) // Restrict
  sublocation      Sublocation?             @relation(fields: [sublocationId], references: [id], onDelete: SetNull)
  performedBy      TeamMember?              @relation(fields: [performedById], references: [inflowId], onDelete: SetNull)
  inventoryBinItem    InventoryBinItem?           @relation(fields: [inventoryBinItemId], references: [id], onDelete: SetNull)
  fromLocation        Location? @relation("LedgerFromLocation", fields: [fromLocationId], references: [inflowId], onDelete: SetNull)
  toLocation        Location? @relation("LedgerToLocation", fields: [toLocationId], references: [inflowId], onDelete: SetNull)

  createdAt        DateTime                 @default(now())

  @@index([productId, createdAt])
  @@index([locationId, createdAt])
  @@index([referenceType, referenceId])
  @@index([transactionType])
  @@index([createdAt])
  @@index([productId, locationId, createdAt])
  @@index([sublocationId])
  @@map("inventory_ledger")
}

enum InventoryReferenceType {
  SALES_ORDER
  PURCHASE_ORDER
  TRANSFER_ORDER
  ADJUSTMENT
  RETURN
  STOCK_COUNT
}

enum InventoryTransactionType {
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALES_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  STOCK_COUNT
  PRODUCTION_IN
  PRODUCTION_OUT
  OPENING_BALANCE
}


