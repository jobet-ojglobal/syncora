// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Sync Logs
model SyncJob {
  id        String   @id @default(cuid())
  source    String
  status    String   @default("pending")
  progress  Int      @default(0)
  hasError       Boolean  @default(false)
  error          String?
  errorType      String?
  failedAttempts Int      @default(0)

  data      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([status])
  @@index([createdAt])
  @@index([hasError])
  @@map("sync_job")
}

// INFLOW MODELS
model InflowWebhook {
  id                      String   @id 
  url                     String   @unique 
  secret                  String?
  events                  Json
  isDisabled              Boolean  @default(false)
  consecutiveFailureCount Int      @default(0)
  lastFailureMessage      String?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("inflow_webhook")
}

model InflowWebhookEvent {
  id          String   @id @default(cuid())
  eventType   String
  payload     Json
  processed   Boolean @default(false)
  receivedAt  DateTime @default(now())

  @@index([eventType])
  @@index([receivedAt])

  @@map("inflow_webhook_event")
}


model LocationWebhook {
  id                      String               @id @default(cuid())
  locationId              String               
  location                Location             @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  url                     String               @unique
  secret                  String?
  events                  Json                 // Array of string event types, e.g., ["salesOrder", "currency", "taxingScheme"]
  isDisabled              Boolean              @default(false)
  consecutiveFailureCount Int                  @default(0)
  lastFailureMessage      String?
  
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  
  deliveryLogs            LocationWebhookEvent[]

  @@map("location_webhook")
}

model LocationWebhookEvent {
  id              String         @id @default(cuid())
  locationWebhookId String
  webhook         LocationWebhook  @relation(fields: [locationWebhookId], references: [id], onDelete: Cascade)
  eventType       String
  payload         Json
  responseStatus  Int?           // Store the receiver's HTTP status code (e.g., 200, 500)
  errorMessage    String?        // Store error details if the fetch fails
  processed       Boolean        @default(false)
  receivedAt      DateTime       @default(now())

  @@index([eventType])
  @@index([receivedAt])
  @@map("location_webhook_event")
}

// PARTNER MODELS

model PartnerWebhook {
  id                      String   @id // partnerSubscriptionId
  url                     String   @unique
  secret                  String?
  events                  Json
  isDisabled              Boolean  @default(false)
  consecutiveFailureCount Int      @default(0)
  lastFailureMessage      String?
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("partner_webhook")
}

model PartnerWebhookEvent {
  id         String   @id @default(cuid())
  eventType  String
  payload    Json
  processed  Boolean  @default(false)
  receivedAt DateTime @default(now())

  @@index([eventType])
  @@index([receivedAt])
  @@map("partner_webhook_event")
}

enum UserRole {
  Admin
  StoreManager
  Customer
  InventoryClerk
  SalesAssociate
  Cashier
  WarehouseStaff
  Auditor
  SupportStaff
}

model User {
  id            String    @id // E.g., NextAuth / Clerk generated id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  
  role          UserRole  @default(Customer)

  // --- RELATIONSHIP TO INFLOW TEAM MEMBER ---
  teamMemberId  String?   @unique
  teamMember    TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)

  inflowCustomerId String?   @unique
  inflowCustomer   Customer? @relation(fields: [inflowCustomerId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@map("user")
}

model Brand {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  logoUrl     String?
  websiteUrl  String?

  products    Product[]
  groups      ProductGroup[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("brand")
}

model Category {
  id          String   @id @default(cuid())
  inflowId    String   @unique
  name        String
  slug        String   @unique // e.g., "digital-cameras"
  isDefault   Boolean  @default(false)    
  description String?
  imageUrl    String?
  parentId          String?
  parent            Category?  @relation("CategoryToCategory", fields: [parentId], references: [inflowId], onUpdate: Cascade)
  children          Category[] @relation("CategoryToCategory")
  productGroups     ProductGroup[]
  products          Product[]

  localMappings     CategoryLocationMap[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@map("category")
}

model CategoryLocationMap {
  id             String       @id @default(cuid())
  categoryId     String       // References Category.inflowId
  locationId     String       // References your Location table identifier
  localId        Int          // The unique INT assigned by that specific local database

  location       Location? @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  category       Category     @relation(fields: [categoryId], references: [inflowId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([categoryId, locationId])
  @@index([locationId, localId])
  @@map("category_location_map")
}

model ProductGroup {
  id                String   @id @default(cuid())
  inflowId          String   @unique
  name              String 
  slug              String   @unique 
  description       String?  @db.Text
  brandId           String?
  categoryId        String?
  isActive          Boolean

  brand             Brand?   @relation(fields: [brandId], references: [id])
  category          Category? @relation(fields: [categoryId], references: [inflowId], onUpdate: Cascade)

  variants          ProductVariant[]
  images            ProductImage[]
  options           ProductGroupOption[]
  tags              ProductGroupTag[]
  features          ProductGroupFeature[]

  localMappings     ProductGroupLocationMap[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@map("product_group")
}

model ProductGroupLocationMap {
  id             String       @id @default(cuid())
  productGroupId String       // References ProductGroup.inflowId
  locationId     String       // References your Location table identifier
  localId        Int          // The unique INT assigned by that specific local database

  location       Location? @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  productGroup   ProductGroup @relation(fields: [productGroupId], references: [inflowId], onDelete: Cascade)

  @@unique([productGroupId, locationId])
  @@index([locationId, localId])
  @@map("product_group_location_map")
}

model ProductVariant {
  id                String   @id @default(cuid())
  inflowId          String   @unique
  productGroupId    String
  productId         String   @unique
  defaultPrice      Decimal  @db.Decimal(18,5)
  isActive          Boolean @default(true)
  signature         String
  variantCount      Int @default(0)

  group             ProductGroup @relation(fields: [productGroupId], references: [inflowId], onDelete: Cascade)
  product           Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  selections        ProductVariantSelection[]

  localMappings     ProductVariantLocationMap[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@unique([productGroupId, productId])
  @@unique([productGroupId, signature])
  @@index([productGroupId])
  @@index([productId])

  @@map("product_variant")
}

model ProductVariantLocationMap {
  id                String       @id @default(cuid())
  productVariantId  String       // References ProductVariant.inflowId
  locationId        String       // References your Location table identifier
  localId           Int          // The unique INT assigned by that specific local database

  location          Location? @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  productVariant    ProductVariant @relation(fields: [productVariantId], references: [inflowId], onDelete: Cascade)

  @@unique([productVariantId, locationId])
  @@index([locationId, localId])
  @@map("product_variant_location_map")
}

enum ProductType {
  StockedProduct
  NonstockedProduct
  Service
}

model Product {
  id                      String   @id @default(cuid())
  inflowId                String   @unique
  sku                     String
  name                    String
  slug                    String   @unique 
  description             String?
  itemType                ProductType?
  autoAssemble            Boolean @default(false)
  isActive                Boolean @default(true)
  isManufacturable        Boolean @default(false)
  isCloudSynced           Boolean @default(false)
  isLocalSynced           Boolean @default(false)
  includeQuantityBuildable Boolean @default(false)
  standardUomName         String?
  trackExpiry             Boolean @default(false)
  trackLots               Boolean @default(false)
  trackSerials            Boolean @default(false)
  shelfLifeDays           Int?
  sellBeforeExpiryDays    Int?
  expiryNotificationDays  Int?
  weight                  Decimal? @db.Decimal(12,4)
  width                   Decimal? @db.Decimal(12,4)
  height                  Decimal? @db.Decimal(12,4)
  length                  Decimal? @db.Decimal(12,4)
  originCountry           String?
  hsTariffNumber          String?
  remarks                 String?
  lastVendorId            String?
  lastModifiedById        String?

  brandId           String?
  brand             Brand? @relation(fields: [brandId], references: [id])
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [inflowId], onUpdate: Cascade)
  lastModifiedBy    TeamMember? @relation(fields: [lastModifiedById], references: [inflowId], onDelete: SetNull)
  lastVendor        Vendor? @relation(fields: [lastVendorId], references: [inflowId])

  purchasingUom         PurchasingUom?
  salesUom              SalesUom?
  cost                  ProductCost?
  variant               ProductVariant?

  tags              ProductTag[]
  features          ProductFeature[]
  inventories       Inventory[]
  inventoryBinItems    InventoryBinItem[]
  adjustmentLines   InventoryAdjustmentLine[]
  costAdjustments   ProductCostAdjustment[]
  inventoryLedger   InventoryLedger[]
  transferOrderLines  TransferOrderLine[]
  barcodes          ProductBarcode[]
  prices            ProductPrice[]
  attachments       ProductAttachment[]
  vendorItems       VendorItem[]
  productOperations ProductOperation[]
  taxCodes          ProductTaxCode[]
  images            ProductImage[]
  reorderSettings   ReorderSetting[]
  bomComponents     ProductBom[]      @relation("ParentBom")
  bomUsedIn         ProductBom[]      @relation("ChildBom")

  orderLineItems         SalesOrderLine[]
  packLines              SalesOrderPackLine[]
  pickLines              SalesOrderPickLine[]
  restockLines           SalesOrderRestockLine[]
  pickAllocationLines    SalesOrderPickAllocationLine[]
  pickAllocationFailures SalesOrderPickAllocationFailure[]


  purchaseLines PurchaseOrderLine[]
  receiveLines  PurchaseOrderReceiveLine[]
  unstockLines  PurchaseOrderUnstockLine[]

  stockeAdjustmentLines StockAdjustmentLine[]

  localMappings   ProductLocationMap[]

  customFields          Json?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  @@map("product")
}

model ProductLocationMap {
  id             String       @id @default(cuid())
  productId      String       // References Product.inflowId
  locationId     String       // References your Location table identifier
  localId        Int          // The unique INT assigned by that specific local database

  location       Location? @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [inflowId], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([locationId, localId])
  @@map("product_location_map")
}

enum ProductPriceType {
  FixedPrice  
  FixedMarkup  
}

model ProductPrice {
  id                String   @id @default(cuid())
  inflowId          String   @unique
  pricingSchemeId   String
  productId         String   
  priceType         ProductPriceType
  unitPrice         Decimal? @db.Decimal(18,5)
  fixedMarkup       Decimal? @db.Decimal(18,5)

  pricingScheme     PricingScheme @relation(fields: [pricingSchemeId], references: [inflowId], onDelete: Cascade)
  product           Product @relation(fields: [productId],references: [inflowId], onDelete: Cascade)

  priceTiers        ProductPriceTier[]
  localMappings     ProductPriceLocationMap[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@unique([pricingSchemeId, productId, priceType])

  @@index([pricingSchemeId])
  @@index([productId])

  @@map("product_price")
}

model ProductPriceLocationMap {
  id              String       @id @default(cuid())
  productPriceId  String       // References ProductPrice.inflowId
  locationId      String       // References your Location table identifier
  localId         Int          // The unique INT assigned by that specific local database

  location        Location? @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  productPrice    ProductPrice @relation(fields: [productPriceId], references: [inflowId], onDelete: Cascade)

  @@unique([productPriceId, locationId])
  @@index([locationId, localId])
  @@map("product_price_location_map")
}

model ProductPriceTier {
  id             String       @id @default(cuid())
  productPriceId String
  minQuantity    Decimal      @db.Decimal(18,4) // e.g., 10.0000 units
  unitPrice      Decimal      @db.Decimal(18,5)
  
  productPrice   ProductPrice @relation(fields: [productPriceId], references: [id], onDelete: Cascade)

  @@index([productPriceId])
  @@map("product_price_tier")
}

model ProductCostAdjustment {
  id                    String   @id @default(cuid())
  inflowId              String   @unique
  productId             String
  lastModifiedById      String?
  dateTime              DateTime
  serial                String?
  unitCost              Decimal  @db.Decimal(18,5)

  product               Product @relation(fields: [productId],references: [inflowId], onDelete: Cascade)
  lastModifiedBy        TeamMember? @relation(fields: [lastModifiedById],references: [inflowId], onDelete: SetNull)

  localMappings         ProductCostAdjustmentLocationMap[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  @@index([productId])
  @@index([lastModifiedById])
  @@index([dateTime])

  @@map("product_cost_adjustment")
}

model ProductCostAdjustmentLocationMap {
  id                       String       @id @default(cuid())
  productCostAdjustmentId  String       // References ProductCostAdjustment.inflowId
  locationId               String       // References your Location table identifier
  localId                  Int          // The unique INT assigned by that specific local database

  location                 Location? @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  productCostAdjustment    ProductCostAdjustment @relation(fields: [productCostAdjustmentId], references: [inflowId], onDelete: Cascade)

  @@unique([productCostAdjustmentId, locationId])
  @@index([locationId, localId])
  @@map("product_cost_adjustment_location_map")
}

model ProductBarcode {
  id            String @id @default(cuid())
  inflowId      String @unique
  productId     String
  barcode       String @unique
  lineNum       Int
  product       Product @relation(fields: [productId],references: [inflowId], onDelete: Cascade)

  localMappings   ProductBarcodeLocationMap[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([productId])
  @@unique([productId, lineNum])

  @@map("product_barcode")
}

model ProductBarcodeLocationMap {
  id             String       @id @default(cuid())
  productBarcodeId String     // References ProductBarcode.inflowId
  locationId     String       // References your Location table identifier
  localId        Int          // The unique INT assigned by that specific local database

  location       Location? @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  productBarcode ProductBarcode @relation(fields: [productBarcodeId], references: [inflowId], onDelete: Cascade)

  @@unique([productBarcodeId, locationId])
  @@index([locationId, localId])
  @@map("product_barcode_location_map")
}

model ProductOperation {
  id                   String        @id @default(cuid())
  inflowId             String        @unique
  productId            String
  operationTypeId      String
  lineNum              Int
  cost                 Decimal       @db.Decimal(12, 4)
  estimatedPerHourCost Decimal       @db.Decimal(12, 4)
  estimatedSeconds     Decimal       @db.Decimal(12, 4)
  instructions         String?       @db.Text
  trackTime            Boolean       @default(false)

  product              Product       @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  operationType        OperationType @relation(fields: [operationTypeId], references: [inflowId])

  localMappings        ProductOperationLocationMap[]

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  @@index([productId])
  @@index([operationTypeId])
  @@unique([productId, lineNum])
  @@map("product_operation")
}

model ProductOperationLocationMap {
  id               String       @id @default(cuid())
  productOperationId String     // References ProductOperation.inflowId
  locationId       String       // References your Location table identifier
  localId          Int          // The unique INT assigned by that specific local database

  location         Location? @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  productOperation ProductOperation @relation(fields: [productOperationId], references: [inflowId], onDelete: Cascade)

  @@unique([productOperationId, locationId])
  @@index([locationId, localId])
  @@map("product_operation_location_map")
}

model OperationType {
  id                   String             @id @default(cuid())
  inflowId             String             @unique
  name                 String
  estimatedPerHourCost Decimal            @db.Decimal(12, 4)
  isActive             Boolean            @default(true)
  isDefault            Boolean            @default(false)
  trackTime            Boolean            @default(false)

  productOperations    ProductOperation[]
  localMappings        OperationTypeLocationMap[]

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?

  @@map("operation_type")
}

model OperationTypeLocationMap {
  id             String       @id @default(cuid())
  operationTypeId String      // References OperationType.inflowId
  locationId     String       // References your Location table identifier
  localId        Int          // The unique INT assigned by that specific local database

  location       Location? @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  operationType  OperationType @relation(fields: [operationTypeId], references: [inflowId], onDelete: Cascade)

  @@unique([operationTypeId, locationId])
  @@index([locationId, localId])
  @@map("operation_type_location_map")
}

model ProductTaxCode {
  id             String       @id @default(cuid())
  productTaxCodeId String     @unique // Storing payload's productTaxCodeId explicitly
  productId      String
  taxCodeId      String
  taxingSchemeId String

  product        Product      @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  taxCode        TaxCode      @relation(fields: [taxCodeId], references: [inflowId])
  taxingScheme   TaxingScheme @relation(fields: [taxingSchemeId], references: [inflowId])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([productId])
  @@index([taxCodeId])
  @@index([taxingSchemeId])
  @@unique([productId, taxCodeId])
  @@map("product_tax_code")
}

model ProductAttachment {
  id               String      @id @default(cuid())
  inflowId         String      @unique // Storing payload's attachmentId
  productId        String
  attachmentUrl    String
  fileName         String
  lastModifiedById String?

  product          Product     @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  lastModifiedBy   TeamMember? @relation(fields: [lastModifiedById], references: [inflowId], onDelete: SetNull)

  localMappings      ProductAttachmentLocationMap[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  @@index([productId])
  @@index([lastModifiedById])
  @@map("product_attachment")
}

model ProductAttachmentLocationMap {
  id                  String       @id @default(cuid())
  productAttachmentId String       // References ProductAttachment.inflowId
  locationId          String       // References your Location table identifier
  localId             Int          // The unique INT assigned by that specific local database

  location            Location? @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  productAttachment   ProductAttachment @relation(fields: [productAttachmentId], references: [inflowId], onDelete: Cascade)

  @@unique([productAttachmentId, locationId])
  @@index([locationId, localId])
  @@map("product_attachment_location_map")
}

model ProductCost {
  id            String   @id @default(cuid())
  inflowId      String   @unique // Storing payload's productCostId
  productId     String   @unique // Enforces 1:1 relation with Product
  cost          Decimal  @db.Decimal(12, 4)

  product       Product  @relation(fields: [productId], references: [inflowId], onDelete: Cascade)

  localMappings     ProductCostLocationMap[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@map("product_cost")
}

model ProductCostLocationMap {
  id             String       @id @default(cuid())
  productCostId  String       // References ProductCost.inflowId
  locationId     String       // References your Location table identifier
  localId        Int          // The unique INT assigned by that specific local database

  location       Location? @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  productCost    ProductCost  @relation(fields: [productCostId], references: [inflowId], onDelete: Cascade)

  @@unique([productCostId, locationId])
  @@index([locationId, localId])
  @@map("product_cost_location_map")
}

model ReorderSetting {
  id                 String   @id @default(cuid())
  inflowId           String   @unique // Storing payload's reorderSettingsId
  productId          String
  locationId         String
  fromLocationId     String?
  vendorId           String?
  defaultSublocation String?
  enableReordering   Boolean  @default(true)
  reorderMethod      ReorderSettingMethod // e.g., PurchaseOrder, TransferOrder
  reorderPoint       Decimal  @db.Decimal(12, 4)
  reorderQuantity    Decimal  @db.Decimal(12, 4)

  product            Product  @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  location           Location @relation("TargetLocation", fields: [locationId], references: [inflowId], onDelete: Cascade)
  fromLocation       Location? @relation("SourceLocation", fields: [fromLocationId], references: [inflowId], onDelete: SetNull)
  vendor             Vendor?   @relation(fields: [vendorId], references: [inflowId], onDelete: SetNull)

  localMappings      ReorderSettingLocationMap[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  @@index([productId])
  @@index([locationId])
  @@index([fromLocationId])
  @@index([vendorId])
  @@map("product_reorder_setting")
}

enum ReorderSettingMethod {
  PurchaseOrder
  StockTransfer
}

model ReorderSettingLocationMap {
  id              String       @id @default(cuid())
  reorderSettingId String      // References reorderSetting.inflowId
  locationId      String       // References your Location table identifier
  localId         Int          // The unique INT assigned by that specific local database

  location        Location? @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  reorderSetting  ReorderSetting @relation(fields: [reorderSettingId], references: [inflowId], onDelete: Cascade)

  @@unique([reorderSettingId, locationId])
  @@index([locationId, localId])
  @@map("reorder_setting_location_map")
}

model ProductBom {
  id             String   @id @default(cuid())
  inflowId       String    @unique
  productId       String   @map("product_id")
  childProductId  String   @map("child_product_id")
  
  // Quantity fields (flattened from InflowBomQuantity)
  standardQuantity Decimal @db.Decimal(12, 4)
  uomQuantity      Decimal @db.Decimal(12, 4)
  uom              String?
  serialNumbers    String[] // Standard string array in PostgreSQL

  timestamp        DateTime @default(now())

  // Relations to parent and child products
  product      Product @relation("ParentBom", fields: [productId], references: [inflowId], onDelete: Cascade)
  childProduct Product @relation("ChildBom", fields: [childProductId], references: [inflowId], onDelete: Cascade)

  localMappings   ProductBomLocationMap[]

  @@index([productId])
  @@index([childProductId])
  @@map("product_boms")
}

