model TaxingScheme {
  id                    String   @id @default(cuid())
  inflowId              String   @unique
  name                  String
  isActive              Boolean  @default(true)
  isDefault             Boolean  @default(false)
  calculateTax2OnTax1   Boolean  @default(false)
  tax1Name              String?
  tax1OnShipping        Boolean  @default(false)
  tax2Name              String?
  tax2OnShipping        Boolean  @default(false)
  defaultTaxCodeId      String?

  defaultTaxCode        TaxCode? @relation( "DefaultTaxCode", fields: [defaultTaxCodeId],references: [inflowId])
  taxCodes              TaxCode[] @relation("SchemeTaxCodes")
  productTaxCodes       ProductTaxCode[]
  customers             Customer[]
  vendors               Vendor[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  @@map("taxing_scheme")
}

model TaxCode {
  id                String   @id @default(cuid())
  inflowId          String   @unique
  taxingSchemeId    String
  name              String
  isActive          Boolean  @default(true)
  tax1Rate          Decimal? @db.Decimal(10,4)
  tax2Rate          Decimal? @db.Decimal(10,4)

  taxingScheme      TaxingScheme @relation("SchemeTaxCodes",fields: [taxingSchemeId],references: [inflowId],onDelete: Cascade)
  defaultForSchemes TaxingScheme[] @relation("DefaultTaxCode")
  productTaxCodes   ProductTaxCode[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@index([taxingSchemeId])

  @@map("tax_code")
}

//  CURRENCIES

enum CurrencyNegativeType {
  Leading
  Trailing
  Parentheses
}

model Currency {
  id                    String   @id @default(cuid())
  inflowId              String   @unique
  name                  String
  isoCode               String
  symbol                String?
  decimalPlaces         Int      @default(2)
  decimalSeparator      String?
  thousandsSeparator    String?
  isSymbolFirst         Boolean  @default(true)
  negativeType          String?
  conversions           CurrencyConversion[]
  pricingSchemes        PricingScheme[]

  customerDues      CustomerDue[]
  customerBalances  CustomerBalance[]
  customerCredits   CustomerCredit[]

  vendorDues        VendorDue[]
  vendorBalances    VendorBalance[]
  vendorCredits     VendorCredit[]

  vendors           Vendor[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  @@index([isoCode])

  @@map("currency")
}

model CurrencyConversion {
  id                    String   @id @default(cuid())
  inflowId              String   @unique
  currencyId            String
  exchangeRate          Decimal  @db.Decimal(18, 8)
  isManual              Boolean  @default(false)
  currency              Currency @relation(fields: [currencyId],references: [inflowId], onDelete: Cascade)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([currencyId])

  @@map("currency_conversion")
}

// PRICING SCHEME MODELS

model PricingScheme {
  id                String   @id @default(cuid())
  inflowId          String   @unique
  currencyId        String
  name              String
  isActive          Boolean  @default(true)
  isDefault         Boolean  @default(false)
  isTaxInclusive    Boolean  @default(false)

  currency          Currency  @relation(fields: [currencyId], references: [inflowId], onDelete: Restrict)
  productPrices     ProductPrice[]
  customers Customer[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@index([currencyId])

  @@map("pricing_scheme")
}

// PAYMENT TERM
model PaymentTerms {
  id              String   @id @default(cuid())
  inflowId        String   @unique
  name            String
  daysDue         Int?
  isActive        Boolean  @default(true)

  customers Customer[]
  vendors   Vendor[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([name])

  @@map("payment_terms")
}

