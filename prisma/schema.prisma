  referenceNumber                   String?
  remarks                           String?       @db.Text

  @@index([purchaseOrderId])

  @@map("purchase_order_payment_line")
}

model PurchaseOrderAttachment {
  attachmentId     String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [inflowId], onDelete: Cascade)
  attachmentUrl    String
  fileName         String
  fileSize         Json?         // Empty or structured size metadata
  lastModifiedById String? 
  
  @@index([purchaseOrderId])

  @@map("purchase_order_attachment")
}


