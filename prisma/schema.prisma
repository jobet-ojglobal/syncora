model StockAdjustment {
  id                     String   @id @default(cuid())
  inflowId               String   @unique
  adjustmentNumber       String
  adjustmentReasonId     String?
  locationId             String
  lastModifiedById       String?
  date                   DateTime
  remarks                String?
  isCancelled            Boolean  @default(false)
  timestamp              String

  custom1                String?
  custom2                String?
  custom3                String?
  custom4                String?
  custom5                String?
  custom6                String?
  custom7                String?
  custom8                String?
  custom9                String?
  custom10               String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  adjustmentReason       AdjustmentReason? @relation(fields: [adjustmentReasonId], references: [inflowId])
  location               Location          @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  lastModifiedBy         TeamMember?             @relation(fields: [lastModifiedById], references: [inflowId], onDelete: SetNull)
  lines                  StockAdjustmentLine[]
  attachments            StockAdjustmentAttachment[]

  @@index([locationId])
  @@index([date])
}

model StockAdjustmentLine {
  id                     String @id @default(cuid())
  inflowId               String @unique
  stockAdjustmentId      String
  productId              String
  description            String?
  standardQuantity       Decimal @db.Decimal(18,5)
  uomQuantity            Decimal @db.Decimal(18,5)
  uom                    String?
  sublocation            String?
  timestamp              String

  stockAdjustment        StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  product                Product @relation(fields: [productId], references: [inflowId])
  serialNumbers          StockAdjustmentSerial[]

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([stockAdjustmentId])
  @@index([productId])
}

model StockAdjustmentSerial {
  id              String @id @default(cuid())
  lineId          String
  serialNumber    String

  line            StockAdjustmentLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([lineId, serialNumber])
}

model StockAdjustmentAttachment {
  id                    String @id @default(cuid())
  inflowId              String @unique
  stockAdjustmentId     String
  fileName              String
  attachmentUrl         String
  fileSize              BigInt?
  lastModifiedDate      DateTime?
  lastModifiedById      String?
  stockAdjustment       StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  lastModifiedBy        TeamMember? @relation(fields: [lastModifiedById], references: [inflowId], onDelete: SetNull)

  @@index([stockAdjustmentId])
}


