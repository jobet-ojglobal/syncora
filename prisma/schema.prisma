// ==========================================
// Sales Order Models
// ==========================================

model SalesOrder {
  id                     String    @id @default(cuid())
  inflowId               String    @unique
  orderNumber            String    @unique
  poNumber               String?
  externalId             String?
  source                 String?
  
  // Financials
  subTotal               Decimal   @db.Decimal(18, 5)
  total                  Decimal   @db.Decimal(18, 5)
  amountPaid             Decimal   @db.Decimal(18, 5)
  balance                Decimal   @db.Decimal(18, 5)
  orderFreight           Decimal   @db.Decimal(18, 5)
  returnFee              Decimal   @db.Decimal(18, 5)
  returnFreight          Decimal   @db.Decimal(18, 5)
  exchangeRate           Float     @default(1.0)
  exchangeRateAutoPulled DateTime?
  
  // Statuses & Flags
  paymentStatus          String
  inventoryStatus        String
  isCancelled            Boolean   @default(false)
  isCompleted            Boolean   @default(false)
  isFullyPicked          Boolean   @default(false)
  isInvoiced             Boolean   @default(false)
  isPicking              Boolean   @default(false)
  isPrioritized          Boolean   @default(false)
  isQuote                Boolean   @default(false)
  isTaxInclusive         Boolean   @default(false)
  needsConfirmation      Boolean   @default(false)
  
  // Dates
  orderDate              DateTime?
  dueDate                DateTime?
  invoicedDate           DateTime?
  paidDate               DateTime?
  requestedShipDate      DateTime?
  shippedDate            DateTime?
  
  // Contact & Remarks
  contactName            String?
  email                  String?
  phone                  String?
  orderRemarks           String?   @db.Text
  packRemarks            String?   @db.Text
  pickRemarks            String?   @db.Text
  restockRemarks         String?   @db.Text
  returnRemarks          String?   @db.Text
  shipRemarks            String?   @db.Text
  shipToCompanyName      String?
  showShipping           Boolean   @default(true)
  timestamp              String
  
  // Embedded / JSON Objects
  billingAddress         Json?     // Stores address1, address2, city, state, country, etc.
  shippingAddress        Json?     // Stores address1, address2, city, state, country, etc.
  customFields           Json?     // Stores custom1 through custom10
  nonCustomerCost        Json?     // Stores { value: "19.99", isPercent: true }
  sameBillingAndShipping Boolean   @default(false)

  // Relations
  customerId             String
  customer               Customer  @relation(fields: [customerId], references: [inflowId])
  
  locationId             String?
  location               Location? @relation(fields: [locationId], references: [inflowId])
  
  assignedToTeamMemberId String?
  assignedToTeamMember   TeamMember? @relation("AssignedOrders", fields: [assignedToTeamMemberId], references: [inflowId])
  
  confirmerTeamMemberId  String?
  confirmerTeamMember    TeamMember? @relation("ConfirmedOrders", fields: [confirmerTeamMemberId], references: [inflowId])
  
  salesRepTeamMemberId   String?
  salesRepTeamMember     TeamMember? @relation("SalesRepOrders", fields: [salesRepTeamMemberId], references: [inflowId])
  salesRep               String?

  paymentTermsId         String?
  paymentTerms           PaymentTerms? @relation(fields: [paymentTermsId], references: [inflowId])
  
  pricingSchemeId        String?
  taxingSchemeId         String?
  currencyId             String?
  lastModifiedById       String?

  // Tax Details
  calculateTax2OnTax1    Boolean   @default(false)
  tax1                   Decimal   @db.Decimal(18, 5)
  tax1Name               String?
  tax1OnShipping         Boolean   @default(false)
  tax1Rate               Decimal   @db.Decimal(18, 5)
  tax2                   Decimal   @db.Decimal(18, 5)
  tax2Name               String?
  tax2OnShipping         Boolean   @default(false)
  tax2Rate               Decimal   @db.Decimal(18, 5)

  // Has-Many Relations
  lines                  SalesOrderLine[]
  packLines              SalesOrderPackLine[]
  paymentLines           SalesOrderPaymentLine[]
  pickLines              SalesOrderPickLine[]
  restockLines           SalesOrderRestockLine[]
  pickAllocationLines    SalesOrderPickAllocationLine[]
  pickAllocationFailures SalesOrderPickAllocationFailure[]
  shipLines              SalesOrderShipLine[]
  costOfGoodsSold        CostOfGoodsSold?
  attachments            SalesOrderAttachment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([inflowId])
  @@index([orderNumber])
  @@index([customerId])
  @@index([locationId])
  @@index([paymentStatus])
  @@index([orderDate])

  @@map("sales_order")
}

model SalesOrderLine {
  salesOrderLineId String     @id @default(uuid())
  salesOrderId     String     
  salesOrder       SalesOrder @relation(fields: [salesOrderId], references: [inflowId], onDelete: Cascade)
  
  productId        String
  product          Product    @relation(fields: [productId], references: [inflowId])
  
  description      String?    @db.Text
  unitPrice        Decimal    @db.Decimal(18, 5)
  subTotal         Decimal    @db.Decimal(18, 5)
  discount         Json?      // Stores { value: "0.00", isPercent: true }
