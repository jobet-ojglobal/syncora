model ProductUom {
  id               String @id @default(cuid())

  productId        String @unique
  uomId            String

  standardQuantity Decimal @db.Decimal(18,4)
  uomQuantity      Decimal @db.Decimal(18,4)

  product          Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  uom              UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@map("product_uom")
}

model ProductSalesUom {
  id               String @id @default(cuid())

  productId        String @unique
  uomId            String

  standardQuantity Decimal @db.Decimal(18,4)
  uomQuantity      Decimal @db.Decimal(18,4)

  product          Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  uom              UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@map("product_sales_uom")
}

model UnitOfMeasure {
  id         String @id @default(cuid())
  code       String @unique
  name       String
  category   UomCategory
  baseFactor Decimal @db.Decimal(18,6)
  isActive   Boolean @default(true)

  fromConversions UnitConversion[] @relation("FromUnit")
  toConversions   UnitConversion[] @relation("ToUnit")

  productSalesUoms ProductSalesUom[]
  productUoms      ProductUom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("unit_of_measure")
}

model UnitConversion {
  id        String @id @default(cuid())

  fromUomId String
  toUomId   String

  factor    Decimal @db.Decimal(18,6)

  fromUom   UnitOfMeasure @relation("FromUnit", fields: [fromUomId], references: [id])
  toUom     UnitOfMeasure @relation("ToUnit", fields: [toUomId], references: [id])

  @@unique([fromUomId, toUomId])
  @@map("unit_conversion")
}

enum UomCategory {
  COUNT
  WEIGHT
  VOLUME
  LENGTH
  AREA
}

model ProductImage {
  id                  String @id @default(cuid())
  inflowId       String @unique
  groupId             String?
  productId           String?
  position            Int @default(0)
  largeUrl            String?
  mediumUncroppedUrl  String?
  mediumUrl           String?
  originalUrl         String?
  smallUrl            String?
  thumbUrl            String?

  group               ProductGroup? @relation(fields: [groupId], references: [inflowId], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [inflowId], onDelete: Cascade)

  @@index([groupId, position])
  @@index([productId, position])

  @@map("product_image")
}

model Attribute {
  id        String @id @default(cuid())
  name      String @unique
  values    AttributeValue[]
  inflowOptions ProductGroupOption[]

  @@map("attribute")
}

model AttributeValue {
  id          String @id @default(cuid())
  value       String
  hexCode     String?
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  inflowValues ProductGroupOptionValue[]

  @@unique([attributeId, value])
}


model ProductVariantSelection {
  id                     String @id @default(cuid())
  variantId              String
  optionId               String
  optionValueId          String

  variant                ProductVariant @relation(fields: [variantId],references: [inflowId], onDelete: Cascade)
  option                 ProductGroupOption @relation(fields: [optionId],references: [inflowId], onDelete: Cascade)
  optionValue            ProductGroupOptionValue @relation(fields: [optionValueId], references: [inflowId], onDelete: Cascade)

  createdAt              DateTime @default(now())

  @@index([variantId])
  @@index([optionId])
  @@index([optionValueId])
  @@unique([variantId,optionId])

  @@map("product_variant_selection")
}

model ProductGroupOption {
  id                    String @id @default(cuid())
  inflowId              String @unique
  productGroupId        String
  lineNum               Int

  attributeId           String
  attribute             Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  productGroup          ProductGroup @relation(fields: [productGroupId],references: [inflowId], onDelete: Cascade)
  values                ProductGroupOptionValue[]
  variantSelections     ProductVariantSelection[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([productGroupId])
  @@unique([productGroupId, attributeId])

  @@map("product_group_option")
}

model ProductGroupOptionValue {
  id                     String @id @default(cuid())
  inflowId               String @unique
  optionId               String
  lineNum                Int

  attributeValueId       String
  attributeValue         AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  option                 ProductGroupOption @relation(fields: [optionId],references: [inflowId], onDelete: Cascade)
  variantSelections      ProductVariantSelection[]

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  
  
  @@index([optionId])
  @@unique([optionId, attributeValueId])
  @@unique([optionId, lineNum])

  @@map("product_group_option_value")
}


// customFields.custom2
model Feature {
  id          String @id @default(cuid())
  name        String @unique // e.g., "Sensor", "Max Resolution", "Weather Sealing"
  products    ProductFeature[]
  groups      ProductGroupFeature[]
  values      FeatureValue[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("feature")
}

model FeatureValue {
  id String @id @default(cuid())
  featureId String
  value String

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  products  ProductFeature[]
  groups    ProductGroupFeature[]

  @@unique([featureId, value])

  @@map("feature_value")
}

model ProductGroupFeature {
  groupId   String
  featureId String
  featureValueId String

  group          ProductGroup @relation(fields: [groupId], references: [inflowId], onDelete: Cascade)
  feature        Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureValue   FeatureValue @relation(fields: [featureValueId], references: [id], onDelete: Cascade)

  @@id([groupId, featureId])

  @@map("group_feature")
}

model ProductFeature {
  productId      String
  featureId      String
  featureValueId String
  
  product        Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  feature        Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureValue   FeatureValue @relation(fields: [featureValueId], references: [id], onDelete: Cascade)

  @@id([productId, featureId])

  @@map("product_feature")
}

// customFields.custom3
model Tag {
  id          String @id @default(cuid())
  name        String @unique
  products    ProductTag[]
  groups      ProductGroupTag[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tag")
}

model ProductGroupTag {
  groupId String
  tagId   String

  group          ProductGroup? @relation(fields: [groupId], references: [inflowId], onDelete: Cascade)
  tag   Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([groupId, tagId])

  @@map("group_tag")
}

model ProductTag {
  productId      String
  tagId          String

  product        Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  tag            Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])

  @@map("product_tag")
}


// Locations

model Location {
  id              String   @id @default(cuid())
  inflowId        String   @unique
  name            String
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  timestamp       String?

  address         LocationAddress?
  inventories     Inventory[]
  sublocations    Sublocation[]
  adjustmentLines     InventoryAdjustmentLine[]
  inventoryLedger     InventoryLedger[]
  teamLocations      TeamMemberLocation[]
  
  outgoingTransfers TransferOrder[] @relation("TransferSourceLocation")
  incomingTransfers TransferOrder[]  @relation("TransferTargetLocation")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deletedAt   DateTime?

  @@map("location")
}

model LocationAddress {
  id            String @id @default(cuid())
  locationId    String @unique
  address1      String?
  address2      String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  remarks       String?
  addressType   String?

  location      Location @relation(fields: [locationId],references: [inflowId], onDelete: Cascade)


  @@map("location_address")
}

model Sublocation {
  id              String @id @default(cuid())
  locationId      String
  name            String
  location        Location @relation(fields: [locationId],references: [inflowId], onDelete: Cascade)
  inventoryBins   InventoryBin[]
  sourceTransferLines TransferOrderLine[] @relation("TransferSourceSublocation")
  targetTransferLines TransferOrderLine[] @relation("TransferTargetSublocation")
  
  adjustmentLines     InventoryAdjustmentLine[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([locationId, name])
  @@index([locationId])

  @@map("sublocation")
}

model Inventory {
  id             String @id @default(cuid())
  productId      String
  locationId     String
  quantityOnHand Decimal @db.Decimal(18,4)
  
  quantityAvailable   Decimal? @db.Decimal(18,4)
  quantityReserved    Decimal? @db.Decimal(18,4)

  // 🚀 REPLENISHMENT CONTROL FIELDS ADDED HERE:
  reorderThreshold  Decimal  @default(0.0000) @db.Decimal(18,4) // Trigger point (e.g., alert if available < 10)
  reorderQuantity   Decimal  @default(0.0000) @db.Decimal(18,4) // Economic order size to auto-request
  isAutoReorderEnabled Boolean @default(false)                  // Automation switch flag
  preferredSourceLocationId String?

  product             Product @relation(fields: [productId],references: [inflowId], onDelete: Cascade)
  location            Location @relation(fields: [locationId],references: [inflowId], onDelete: Cascade)
  bins                InventoryBin[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])

  @@map("inventory")
}

model InventoryBin {
  id             String @id @default(cuid())
  inventoryId    String
  productId      String
  sublocationId  String
  quantity       Decimal @db.Decimal(18,4)

  inventory           Inventory @relation(fields: [inventoryId],references: [id], onDelete: Cascade)
  product             Product @relation(fields: [productId],references: [inflowId], onDelete: Cascade)
  sublocation         Sublocation @relation(fields: [sublocationId],references: [id], onDelete: Cascade)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([productId,sublocationId])

  @@map("inventory_bin")
}

model InventoryAdjustment {
  id                String   @id @default(cuid())
  adjustmentNumber  String   @unique
  reason            AdjustmentReason
  notes             String?
  performedById     String
  performedBy       User     @relation(fields: [performedById], references: [id], onDelete: Cascade)
  lines             InventoryAdjustmentLine[]
  createdAt         DateTime @default(now())
  @@map("inventory_adjustment")
}

model InventoryAdjustmentLine {
  id                    String @id @default(cuid())
  adjustmentId          String
  productId             String
  locationId            String
  sublocationId         String?
  quantityBefore        Decimal @db.Decimal(18,4)
  quantityAdjusted      Decimal @db.Decimal(18,4)
  quantityAfter         Decimal @db.Decimal(18,4)
  reason                String?
  adjustment            InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product               Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  location              Location @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
  sublocation           Sublocation? @relation(fields: [sublocationId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())

  @@index([productId])
  @@index([locationId])

  @@map("inventory_adjustment_line")
}

enum AdjustmentReason {
  STOCK_COUNT
  DAMAGE
  LOSS
  THEFT
  EXPIRED
  RETURN
  CORRECTION
  MANUAL
}

model InventoryLedger {
  id                String @id @default(cuid())
  productId         String
  locationId        String
  sublocationId     String?
  transactionType   InventoryTransactionType
  referenceType     String?
  referenceId       String?
  quantityChange    Decimal @db.Decimal(18,4)
  quantityBefore    Decimal @db.Decimal(18,4)
  quantityAfter     Decimal @db.Decimal(18,4)
  performedById     String?
  createdAt         DateTime @default(now())
  product           Product @relation(fields: [productId], references: [inflowId], onDelete: Cascade)
  location          Location @relation(fields: [locationId], references: [inflowId], onDelete: Cascade)
}

enum InventoryTransactionType {
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  PURCHASE
  SALE
  RETURN
}

model TransferOrder {
  id                String   @id @default(cuid())
  transferNumber    String   @unique
  sourceLocationId  String
  targetLocationId  String
  status            TransferOrderStatus @default(DRAFT)
  remarks           String?
  transferredAt     DateTime?
  receivedAt        DateTime?

  sourceLocation    Location @relation("TransferSourceLocation",fields: [sourceLocationId],references: [inflowId], onDelete: Cascade)
  targetLocation    Location @relation("TransferTargetLocation",fields: [targetLocationId],references: [inflowId], onDelete: Cascade)
  lines             TransferOrderLine[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sourceLocationId])
  @@index([targetLocationId])

  @@map("transfer_order")
}

model TransferOrderLine {
  id                    String @id @default(cuid())
  transferOrderId       String
  productId             String
  sourceSublocationId   String?
  targetSublocationId   String?
  quantity              Decimal @db.Decimal(18,4)

  transferOrder         TransferOrder @relation(fields: [transferOrderId],references: [id], onDelete: Cascade)
  product               Product @relation(fields: [productId],references: [inflowId], onDelete: Cascade)
  sourceSublocation     Sublocation? @relation("TransferSourceSublocation",fields: [sourceSublocationId], references: [id], onDelete: Cascade)
  targetSublocation     Sublocation? @relation("TransferTargetSublocation",fields: [targetSublocationId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())

  @@index([transferOrderId])
  @@index([productId])

  @@map("transfer_order_line")
}

enum TransferOrderStatus {
  DRAFT
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model TeamMember {
  id                  String   @id @default(cuid())

  inflowId            String   @unique
  name                String
  email               String   @unique

  isActive            Boolean  @default(true)
  canBeSalesRep       Boolean  @default(false)

  accessAllLocations  Boolean  @default(false)

  accessRights        TeamMemberAccessRight[]
  locations           TeamMemberLocation[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  @@map("team_member")
}

model TeamMemberAccessRight {
  id            String     @id @default(cuid())

  teamMemberId  String
  rightName     String

  teamMember    TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, rightName])
  @@index([rightName])

  @@map("team_member_access_right")
}

model TeamMemberLocation {
  id                String     @id @default(cuid())

  teamMemberId      String
  locationInflowId  String

  teamMember        TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  location          Location   @relation(fields: [locationInflowId],references: [inflowId], onDelete: Cascade)

  @@unique([teamMemberId, locationInflowId])

  @@map("team_member_location")
}


