  product       Product @relation(fields: [productId],references: [inflowId],onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([vendorId, productId])

  @@index([vendorId])
  @@index([productId])

  @@map("vendor_item")
}


