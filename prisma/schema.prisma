model InflowWebhook {
  id                      String   @id // webHookSubscriptionId
  url                     String   @unique // <--- ADD THIS @unique ANNOTATION

  secret                  String?
  events                  Json
  isDisabled              Boolean  @default(false)
  consecutiveFailureCount Int      @default(0)
  lastFailureMessage      String?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("inflow_webhook")
}

model InflowIntegration {
  id          String   @id @default(cuid())
  webhookId   String?  @unique
  webhookUrl  String?
  secret      String?
  isConnected Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("inflow_integration")
}

model InflowWebhookEvent {
  id          String   @id @default(cuid())
  eventType   String
  payload     Json
  processed   Boolean @default(false)
  receivedAt  DateTime @default(now())

  @@index([eventType])
  @@index([receivedAt])

  @@map("inflow_webhook_event")
}